@{
    ViewData["Title"] = "Asistencia";
    ViewData["Subtitle"] = "Consulta, porcentajes y reportes de asistencia";
    ViewData["Icon"] = "bi-clipboard-data";

    // MCAF-01-13: solo administración y dirección cierran el período
    bool puedeCerrar = (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Director))
                       && User.TienePermiso("Asistencia", "Editar");
    bool esDocente = User.IsInRole(RolesSistema.Docente);
}

@section Acciones {
    <button type="button" id="btnExportar" class="btn btn-outline-primary">
        <i class="bi bi-file-earmark-excel"></i> Exportar a Excel
    </button>
    @if (puedeCerrar)
    {
        <button type="button" id="btnCerrarPeriodo" class="btn btn-outline-danger" disabled>
            <i class="bi bi-lock"></i> Cerrar período
        </button>
    }
}

@if (esDocente)
{
    <div class="alert alert-info small">
        <i class="bi bi-info-circle"></i> Se muestran únicamente las clases que usted imparte.
    </div>
}

<div id="estadoCierre" class="alert d-none" role="status"></div>

<div class="card mb-4">
    <div class="card-body">
        <form id="formFiltros" class="row g-2">
            <div class="col-md-4 col-lg-3">
                <label for="fPeriodo" class="form-label small mb-1">Período lectivo</label>
                <select id="fPeriodo" class="form-select"></select>
            </div>
            <div class="col-md-4 col-lg-3">
                <label for="fGrado" class="form-label small mb-1">Grado</label>
                <select id="fGrado" class="form-select"></select>
            </div>
            <div class="col-md-4 col-lg-2">
                <label for="fSeccion" class="form-label small mb-1">Sección</label>
                <select id="fSeccion" class="form-select"></select>
            </div>
            <div class="col-md-4 col-lg-2">
                <label for="fGrupo" class="form-label small mb-1">Grupo</label>
                <select id="fGrupo" class="form-select"></select>
            </div>
            <div class="col-md-8 col-lg-2">
                <label for="fCurso" class="form-label small mb-1">Curso</label>
                <select id="fCurso" class="form-select"></select>
            </div>
            <div class="col-md-4 col-lg-3">
                <label for="fTexto" class="form-label small mb-1">Estudiante</label>
                <input id="fTexto" class="form-control" placeholder="Nombre, carné o identificación" maxlength="100" />
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <label for="fDesde" class="form-label small mb-1">Desde</label>
                <input id="fDesde" type="date" class="form-control" />
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <label for="fHasta" class="form-label small mb-1">Hasta</label>
                <input id="fHasta" type="date" class="form-control" />
            </div>
            <div class="col-6 col-md-4 col-lg-1">
                <label for="fUmbral" class="form-label small mb-1">Umbral %</label>
                <input id="fUmbral" type="number" min="1" max="100" step="1" class="form-control" />
            </div>
            <div class="col-6 col-md-4 col-lg-2 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="fSoloBajo" />
                    <label class="form-check-label small" for="fSoloBajo">Solo bajo el umbral</label>
                </div>
            </div>
            <div class="col-md-4 col-lg-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-search"></i> Buscar
                </button>
                <button type="button" id="btnLimpiar" class="btn btn-outline-secondary" title="Limpiar filtros">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tab-resumen" data-bs-toggle="tab" data-bs-target="#panelResumen"
                        type="button" role="tab" aria-controls="panelResumen" aria-selected="true">
                    Porcentaje por estudiante y curso
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-registros" data-bs-toggle="tab" data-bs-target="#panelRegistros"
                        type="button" role="tab" aria-controls="panelRegistros" aria-selected="false">
                    Registros
                </button>
            </li>
        </ul>
    </div>

    <div class="card-body tab-content">

        <div class="tab-pane fade show active" id="panelResumen" role="tabpanel" aria-labelledby="tab-resumen">
            <div id="resumenContadores" class="d-flex flex-wrap gap-2 small mb-3"></div>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle" id="tblResumen">
                    <thead>
                        <tr>
                            <th>Estudiante</th>
                            <th>Grado / sección</th>
                            <th>Grupo</th>
                            <th>Curso</th>
                            <th class="text-center" title="Presentes">P</th>
                            <th class="text-center" title="Ausentes">A</th>
                            <th class="text-center" title="Tardías">T</th>
                            <th class="text-center" title="Justificadas">J</th>
                            <th class="text-center">Total</th>
                            <th class="text-center">% asistencia</th>
                            <th class="text-end">Historial</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td colspan="11" class="text-center text-muted">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-pane fade" id="panelRegistros" role="tabpanel" aria-labelledby="tab-registros">
            <div class="row g-2 mb-3">
                <div class="col-sm-6 col-md-3">
                    <label for="fEstado" class="form-label small mb-1">Estado</label>
                    <select id="fEstado" class="form-select form-select-sm">
                        <option value="">Todos los estados</option>
                        <option value="Presente">Presente</option>
                        <option value="Ausente">Ausente</option>
                        <option value="Tardia">Tardía</option>
                        <option value="Justificada">Justificada</option>
                    </select>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle" id="tblRegistros">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Clase</th>
                            <th>Curso</th>
                            <th>Grado / sección</th>
                            <th>Estudiante</th>
                            <th>Estado</th>
                            <th>Observación</th>
                            <th>Docente</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td colspan="8" class="text-center text-muted">Abra esta pestaña para cargar los registros.</td></tr>
                    </tbody>
                </table>
            </div>
            <small id="registrosConteo" class="text-muted"></small>
        </div>

    </div>
</div>

<partial name="_ModalHistorialAsistencia" />

@section Scripts {
    <script src="~/js/asistencia-comun.js" asp-append-version="true"></script>
    <script src="~/js/asistencia-consulta.js" asp-append-version="true"></script>
}
