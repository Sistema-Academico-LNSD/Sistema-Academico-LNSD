@* MCAF-01-06: historial de un estudiante en un curso. Lo usan Registrar y Consulta. *@
<div class="modal fade" id="modalHistorial" tabindex="-1" aria-hidden="true" aria-labelledby="tituloHistorial">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tituloHistorial">Historial de asistencia</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p id="historialSubtitulo" class="text-muted small mb-3"></p>
                <div id="historialResumen" class="d-flex flex-wrap gap-2 mb-3"></div>
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Clase</th>
                                <th>Estado</th>
                                <th>Observación</th>
                            </tr>
                        </thead>
                        <tbody id="historialFilas">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
