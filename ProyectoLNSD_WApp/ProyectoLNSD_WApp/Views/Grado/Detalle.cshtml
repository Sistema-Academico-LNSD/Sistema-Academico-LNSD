@{
    ViewData["Title"] = "Detalle del grado";
    ViewData["Icon"] = "bi-diagram-3";
}

@section Acciones {
    <a class="btn btn-outline-secondary" asp-controller="Grado" asp-action="Index">
        <i class="bi bi-arrow-left"></i> Volver al listado
    </a>
}

<div class="card" id="detalleGrado" data-id-grado="@ViewBag.IdGrado">
    <div class="card-header">
        <h2 id="tituloDetalle">Detalle del grado</h2>
    </div>
    <div class="card-body">

        <p id="infoGrado" class="mb-4"></p>

        <h3 class="section-heading">Grupos o secciones asociadas</h3>

        <p id="sinSecciones" class="text-muted d-none">
            No existen grupos o secciones asociadas.
        </p>

        <div class="table-responsive">
            <table class="table table-striped table-hover" id="tblDetalleSecciones">
                <thead>
                    <tr>
                        <th>Sección</th>
                        <th>Capacidad</th>
                        <th>Cupos</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/grado-detalle.js" asp-append-version="true"></script>
}
