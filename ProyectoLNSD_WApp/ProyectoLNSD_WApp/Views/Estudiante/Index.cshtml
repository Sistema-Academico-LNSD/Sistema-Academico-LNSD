@{
    ViewData["Title"] = "Estudiantes";
    ViewData["Subtitle"] = "Expedientes de la población estudiantil";
    ViewData["Icon"] = "bi-backpack2";
    bool puedeCrear = User.TienePermiso("Estudiantes", "Crear");
    bool puedeEditar = User.TienePermiso("Estudiantes", "Editar");
}

@section Acciones {
    @if (puedeCrear)
    {
        <button type="button" id="btnNuevoEstudiante" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo estudiante
        </button>
    }
}

<div class="card">
    <div class="card-body">

            <div class="row g-2 mb-3">
                <div class="col-md-5">
                    <input type="text" id="txtBuscar" class="form-control"
                           placeholder="Nombre, identificación, correo, carné o encargado..." />
                </div>

                <div class="col-md-3">
                    <select id="ddlFiltroGrado" class="form-select">
                        <option value="">Todos los grados</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <select id="ddlFiltroEstado" class="form-select">
                        <option value="">Todos</option>
                        <option value="true">Activos</option>
                        <option value="false">Inactivos</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="button" id="btnBuscar" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                    <button type="button" id="btnLimpiar" class="btn btn-outline-secondary" title="Limpiar filtros">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table id="tblEstudiantes" class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Carné</th>
                            <th>Identificación</th>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Grado</th>
                            <th>Estado académico</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <small id="lblTotal" class="text-muted"></small>

        </div>
    </div>


@* Permisos JS *@
<input type="hidden" id="hdnPuedeEditar" value="@(puedeEditar ? "true" : "false")" />

@if (puedeCrear || puedeEditar)
{
    @await Html.PartialAsync("_ModalEstudiante")
}

@await Html.PartialAsync("_ModalExpediente")

@if (puedeEditar)
{
    @await Html.PartialAsync("_ModalEncargados")
}

@section Scripts {
    <script src="~/js/estudiante.js" asp-append-version="true"></script>
    @if (puedeEditar)
    {
        <script src="~/js/estudiante-encargados.js" asp-append-version="true"></script>
    }
}
