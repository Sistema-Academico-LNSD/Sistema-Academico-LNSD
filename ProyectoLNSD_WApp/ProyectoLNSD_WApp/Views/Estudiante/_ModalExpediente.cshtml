<div class="modal fade" id="modalExpediente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-folder2-open"></i> Expediente del estudiante</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">

                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h4 class="mb-0" id="expNombre"></h4>
                        <span class="text-muted">Carné: <strong id="expCarnet"></strong></span>
                    </div>
                    <span id="expEstado" class="badge fs-6"></span>
                </div>

                <h6 class="text-primary border-bottom pb-1 mb-3">
                    <i class="bi bi-person"></i> Datos personales y de contacto
                </h6>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="text-muted small">Identificación</div>
                        <div id="expIdentificacion"></div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Fecha de nacimiento</div>
                        <div id="expFechaNacimiento"></div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Teléfono</div>
                        <div id="expTelefono"></div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Correo</div>
                        <div id="expCorreo"></div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Correo de emergencia</div>
                        <div id="expCorreoEmergencia"></div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Dirección</div>
                        <div id="expDireccion"></div>
                    </div>
                </div>

                <h6 class="text-primary border-bottom pb-1 mb-3">
                    <i class="bi bi-mortarboard"></i> Información académica
                </h6>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="text-muted small">Grado de referencia</div>
                        <div id="expGrado"></div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Estado académico</div>
                        <div id="expEstadoAcademico"></div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Fecha de ingreso</div>
                        <div id="expFechaIngreso"></div>
                    </div>
                </div>

                <h6 class="text-primary border-bottom pb-1 mb-3">
                    <i class="bi bi-heart-pulse"></i> Información médica y de atención
                </h6>

                <div class="row g-3 mb-4">
                    <div class="col-md-12">
                        <div class="text-muted small">Alergias</div>
                        <div id="expAlergias" style="white-space: pre-wrap;"></div>
                    </div>
                    <div class="col-md-12">
                        <div class="text-muted small">Observaciones médicas</div>
                        <div id="expObservacionesMedicas" style="white-space: pre-wrap;"></div>
                    </div>
                    <div class="col-md-12">
                        <div class="text-muted small">Adecuaciones educativas</div>
                        <div id="expAdecuaciones" style="white-space: pre-wrap;"></div>
                    </div>
                </div>

                <h6 class="text-primary border-bottom pb-1 mb-3">
                    <i class="bi bi-people"></i> Encargados asociados
                </h6>

                <div class="table-responsive">
                    <table id="tblExpEncargados" class="table table-sm table-striped align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Nombre</th>
                                <th>Parentesco</th>
                                <th>Teléfono</th>
                                <th>Correo</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>

        </div>
    </div>
</div>
