@{
    int idRol = (int)(ViewData["IdRol"] ?? 0);
    string? nombreRol = ViewData["NombreRol"] as string;

    string rolMostrado = nombreRol ?? "Rol #" + idRol;

    ViewData["Title"] = "Permisos: " + rolMostrado;
    ViewData["Subtitle"] = "Marcá las acciones permitidas por módulo";
    ViewData["Icon"] = "bi-shield-lock";
}

@section Acciones {
    <a asp-controller="Permiso" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Volver
    </a>
}

<div class="card">
    <div class="card-body">

        @Html.AntiForgeryToken()
        <input type="hidden" id="hdnIdRol" value="@idRol" />

        <div id="alertPermisos" class="alert d-none" role="alert"></div>

        <div class="table-responsive">
            <table id="tblMatrizPermisos" class="table table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Módulo</th>
                        <th class="text-center">Ver</th>
                        <th class="text-center">Crear</th>
                        <th class="text-center">Editar</th>
                        <th class="text-center">Eliminar</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>

        <button type="button" id="btnGuardarPermisos" class="btn btn-primary">
            <i class="bi bi-save"></i> Guardar cambios
        </button>

    </div>
</div>

@section Scripts {
    <script src="~/js/permiso.js" asp-append-version="true"></script>
}
