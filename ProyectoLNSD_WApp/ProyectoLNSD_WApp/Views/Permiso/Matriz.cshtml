@{
    ViewData["Title"] = "Matriz de Permisos";
    int idRol = (int)(ViewData["IdRol"] ?? 0);
    string? nombreRol = ViewData["NombreRol"] as string;
}

<div class="container-fluid mt-4">

    <div class="card shadow border-0">

        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">

            <div>
                <h3 class="mb-0">
                    <i class="bi bi-shield-lock"></i>
                    Permisos: @(nombreRol ?? $"Rol #{idRol}")
                </h3>
                <small>Marcá las acciones permitidas por módulo</small>
            </div>

            <a asp-controller="Permiso" asp-action="Index" class="btn btn-light btn-sm">
                <i class="bi bi-arrow-left"></i>
                Volver
            </a>

        </div>

        <div class="card-body">

            <input type="hidden" id="hdnIdRol" value="@idRol" />

            <div id="alertPermisos" class="alert d-none" role="alert"></div>

            <div class="table-responsive">

                <table id="tblMatrizPermisos" class="table table-bordered align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Módulo</th>
                            <th class="text-center">Ver</th>
                            <th class="text-center">Crear</th>
                            <th class="text-center">Editar</th>
                            <th class="text-center">Eliminar</th>
                        </tr>
                    </thead>

                    <tbody>
                    </tbody>

                </table>

            </div>

            <button type="button" id="btnGuardarPermisos" class="btn btn-primary">
                <i class="bi bi-save"></i>
                Guardar cambios
            </button>

        </div>

    </div>

</div>

@section Scripts {

    @Html.AntiForgeryToken()

    <script src="~/js/permiso.js"></script>
}