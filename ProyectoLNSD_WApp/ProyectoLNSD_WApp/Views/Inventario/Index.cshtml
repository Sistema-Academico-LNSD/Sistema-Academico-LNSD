@{
    ViewData["Title"] = "Inventario";
    ViewData["Subtitle"] = "Artículos de la bodega institucional";
    ViewData["Icon"] = "bi-box-seam";

    bool puedeCrear = User.TienePermiso("Inventario", "Crear");
    bool puedeEditar = User.TienePermiso("Inventario", "Editar");
}

@section Acciones {
    @if (puedeCrear)
    {
        <button type="button" id="btnNuevoArticulo" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Nuevo artículo
        </button>
    }
}

<div id="alertaMinimo" class="alert alert-warning d-none align-items-center justify-content-between">
    <span><i class="bi bi-exclamation-triangle"></i> <strong id="alertaMinimoTexto"></strong></span>
    <button type="button" id="btnVerBajoMinimo" class="btn btn-sm btn-outline-dark">Ver artículos</button>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label for="fTexto" class="form-label small mb-1">Nombre</label>
                <input id="fTexto" class="form-control" maxlength="150" placeholder="Buscar por nombre..." />
            </div>
            <div class="col-md-3">
                <label for="fCategoria" class="form-label small mb-1">Tipo</label>
                <select id="fCategoria" class="form-select">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="fEstado" class="form-label small mb-1">Estado</label>
                <select id="fEstado" class="form-select">
                    <option value="">Todos</option>
                    <option value="Activo" selected>Activos</option>
                    <option value="Inactivo">Inactivos</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="button" id="btnLimpiar" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle"></i> Limpiar
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle" id="tblArticulos">
                <thead>
                    <tr>
                        <th>Artículo</th>
                        <th>Tipo</th>
                        <th class="text-end">Disponible</th>
                        <th class="text-end">Mínimo</th>
                        <th>Vence</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td colspan="7" class="text-center text-muted">Cargando...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalArticulo" tabindex="-1" aria-labelledby="modalArticuloTitulo" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalArticuloTitulo">Nuevo artículo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="formArticulo" novalidate>
                    <input type="hidden" id="aId" value="0" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="aCategoria" class="form-label">Tipo de inventario</label>
                            <select id="aCategoria" class="form-select" required>
                                <option value="">Seleccione...</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="aNombre" class="form-label">Nombre</label>
                            <input id="aNombre" class="form-control" maxlength="150" required />
                        </div>
                        <div class="col-12">
                            <label for="aDescripcion" class="form-label">Descripción <span class="text-muted small">(opcional)</span></label>
                            <textarea id="aDescripcion" class="form-control" rows="2" maxlength="300"></textarea>
                        </div>
                        <div class="col-md-4">
                            <label for="aCantidad" class="form-label">Cantidad que ingresa</label>
                            <input id="aCantidad" type="number" min="0" step="1" class="form-control" value="0" />
                            <div id="aCantidadAyuda" class="form-text d-none">
                                Cambia con las entradas y salidas, no se edita aquí.
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label for="aUnidad" class="form-label">Unidad de medida</label>
                            <input id="aUnidad" class="form-control" maxlength="30" list="listaUnidades" required />
                            <datalist id="listaUnidades">
                                <option value="Unidad"></option>
                                <option value="Caja"></option>
                                <option value="Paquete"></option>
                                <option value="Resma"></option>
                                <option value="Litro"></option>
                                <option value="Galón"></option>
                                <option value="Kilogramo"></option>
                            </datalist>
                        </div>
                        <div class="col-md-4">
                            <label for="aMinima" class="form-label">Cantidad mínima</label>
                            <input id="aMinima" type="number" min="0" step="1" class="form-control" value="0" />
                            <div class="form-text">0 = sin mínimo.</div>
                        </div>
                        <div class="col-md-4">
                            <label for="aVence" class="form-label">Vencimiento <span class="text-muted small">(si aplica)</span></label>
                            <input id="aVence" type="date" class="form-control" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnGuardarArticulo" class="btn btn-primary">
                    <i class="bi bi-save"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalMovimiento" tabindex="-1" aria-labelledby="modalMovimientoTitulo" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalMovimientoTitulo">Registrar movimiento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="formMovimiento" novalidate>
                    <input type="hidden" id="mIdInventario" value="0" />
                    <input type="hidden" id="mTipo" value="" />

                    <div class="alert alert-light border small mb-3" id="mResumen"></div>

                    <div class="mb-3">
                        <label for="mCantidad" class="form-label">Cantidad</label>
                        <input id="mCantidad" type="number" min="1" step="1" class="form-control" />
                    </div>

                    <div id="mResponsable" class="d-none">
                        <div class="mb-3">
                            <label for="mNombre" class="form-label">Nombre de quien retira</label>
                            <input id="mNombre" class="form-control" maxlength="150" />
                        </div>
                        <div class="mb-3">
                            <label for="mCedula" class="form-label">Cédula</label>
                            <input id="mCedula" class="form-control" maxlength="30" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="mMotivo" class="form-label" id="mMotivoEtiqueta">Motivo</label>
                        <textarea id="mMotivo" class="form-control" rows="2" maxlength="300"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnGuardarMovimiento" class="btn btn-primary">
                    <i class="bi bi-save"></i> Registrar
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalHistorial" tabindex="-1" aria-labelledby="modalHistorialTitulo" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalHistorialTitulo">Historial de movimientos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="hResumen" class="alert alert-light border small"></div>
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle" id="tblHistorial">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Movimiento</th>
                                <th class="text-end">Cantidad</th>
                                <th class="text-end">Existencia</th>
                                <th>Responsable</th>
                                <th>Motivo</th>
                                <th>Registró</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
        <script>
        window.inventarioPermisos = {
            crear: @(puedeCrear ? "true" : "false"),
            editar: @(puedeEditar ? "true" : "false")
        };
    </script>
    <script src="~/js/inventario.js" asp-append-version="true"></script>
}