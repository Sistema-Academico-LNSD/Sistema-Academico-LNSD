@{
    ViewData["Title"] = "Tipos de inventario";
    ViewData["Subtitle"] = "Clasificación de los artículos de la bodega institucional";
    ViewData["Icon"] = "bi-tags";

    bool puedeCrear = User.TienePermiso("Inventario", "Crear");
    bool puedeEditar = User.TienePermiso("Inventario", "Editar");
}

@section Acciones {
    @if (puedeCrear)
    {
        <button type="button" id="btnNuevoTipo" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Nuevo tipo
        </button>
    }
}

<div class="alert alert-info small">
    <i class="bi bi-info-circle"></i>
    Un tipo desactivado no permite registrar artículos nuevos, pero conserva los artículos que ya tiene.
</div>

<div class="card">
    <div class="card-body">
        <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="tVerInactivos" />
            <label class="form-check-label small" for="tVerInactivos">Mostrar tipos desactivados</label>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle" id="tblTipos">
                <thead>
                    <tr>
                        <th>Tipo</th>
                        <th>Artículos</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td colspan="4" class="text-center text-muted">Cargando...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalTipo" tabindex="-1" aria-labelledby="modalTipoTitulo" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTipoTitulo">Nuevo tipo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="formTipo" novalidate>
                    <input type="hidden" id="tId" value="0" />
                    <div class="mb-3">
                        <label for="tNombre" class="form-label">Nombre</label>
                        <input id="tNombre" class="form-control" maxlength="100" required />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnGuardarTipo" class="btn btn-primary">
                    <i class="bi bi-save"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.inventarioPermisos = { editar: @(puedeEditar ? "true" : "false") };
    </script>
    <script src="~/js/inventario-tipos.js" asp-append-version="true"></script>
}