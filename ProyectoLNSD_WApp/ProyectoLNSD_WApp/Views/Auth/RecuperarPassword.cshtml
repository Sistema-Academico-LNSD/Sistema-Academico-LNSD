@model ProyectoLNSD_WApp.BLL.DTO.UsuarioActions.SolicitarRecuperacionDTO
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Recuperar contraseña";
}

<div id="alertRecuperar" class="alert d-none" role="alert"></div>

<p class="text-muted small">
    Ingresá el correo con el que te registraste. Si existe una cuenta
    asociada, te vamos a enviar un enlace para restablecer tu contraseña.
</p>

<form id="formRecuperar">

    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="Correo" class="form-label">Correo electrónico</label>
        <input asp-for="Correo" class="form-control" autocomplete="username" autofocus />
    </div>

    <div class="d-grid mt-4">
        <button type="submit" id="btnRecuperar" class="btn btn-primary">Enviar enlace de recuperación</button>
    </div>

</form>

<div class="text-center mt-3">
    <a asp-controller="Auth" asp-action="Login" class="small">Volver a iniciar sesión</a>
</div>
