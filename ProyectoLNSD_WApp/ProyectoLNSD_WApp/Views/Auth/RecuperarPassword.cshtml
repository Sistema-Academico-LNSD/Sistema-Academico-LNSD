@model ProyectoLNSD_WApp.BLL.DTO.UsuarioActions.SolicitarRecuperacionDTO
@{
    Layout = null;
    ViewData["Title"] = "Recuperar contraseña";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProyectoLNSD_WApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">

    <a asp-controller="Home" asp-action="Index" class="back-home-link">
        <i class="bi bi-arrow-left"></i> Volver al inicio
    </a>

    <div class="d-flex align-items-center justify-content-center min-vh-100">

        <div class="card shadow border-0" style="width: 100%; max-width: 420px;">

            <div class="card-header bg-primary text-white text-center py-3">
                <h4 class="mb-0">Campus Virtual LNSD</h4>
                <small>Recuperar contraseña</small>
            </div>

            <div class="card-body p-4">

                <div id="alertRecuperar" class="alert d-none" role="alert"></div>

                <p class="text-muted small">
                    Ingresá el correo con el que te registraste. Si existe una cuenta
                    asociada, te vamos a enviar un enlace para restablecer tu contraseña.
                </p>

                <form id="formRecuperar">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label">Correo electrónico</label>
                        <input asp-for="Correo" class="form-control" autocomplete="username" />
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" id="btnRecuperar" class="btn btn-primary">
                            Enviar enlace de recuperación
                        </button>
                    </div>

                </form>

                <div class="text-center mt-3">
                    <a asp-controller="Auth" asp-action="Login" class="small">
                        Volver a iniciar sesión
                    </a>
                </div>

            </div>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/auth.js"></script>

</body>
</html>