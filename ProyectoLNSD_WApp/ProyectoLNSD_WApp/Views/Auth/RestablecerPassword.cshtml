@model ProyectoLNSD_WApp.BLL.DTO.UsuarioActions.RestablecerPasswordDTO
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="card shadow border-0" style="width: 100%; max-width: 420px;">

    <div class="card-header bg-primary text-white text-center py-3">
        <h4 class="mb-0">Sistema Académico LNSD</h4>
        <small>Restablecer contraseña</small>
    </div>

    <div class="card-body p-4">

        <div id="alertRestablecer" class="alert d-none" role="alert"></div>

        <form id="formRestablecer">

            @Html.AntiForgeryToken()
            <input type="hidden" id="Token" name="Token" value="@ViewData["Token"]" />

            <div class="mb-3">
                <label asp-for="NuevaPassword" class="form-label">Nueva contraseña</label>
                <input asp-for="NuevaPassword" type="password" class="form-control" autocomplete="new-password" />
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmarPassword" class="form-label">Confirmar contraseña</label>
                <input asp-for="ConfirmarPassword" type="password" class="form-control" autocomplete="new-password" />
            </div>

            <div class="d-grid mt-4">
                <button type="submit" id="btnRestablecer" class="btn btn-primary">
                    Restablecer contraseña
                </button>
            </div>

        </form>

    </div>

</div>