@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="d-flex justify-content-center mt-4">

    <div class="card shadow border-0 text-center" style="width: 100%; max-width: 560px;">

        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0">
                <i class="bi bi-shield-lock"></i>
                Acceso denegado
            </h4>
        </div>

        <div class="card-body p-4">

            <p class="mb-2">
                Tu cuenta no tiene permisos para acceder a esta sección.
            </p>

            <p class="text-muted small mb-4">
                Si considerás que deberías tener acceso, solicitalo a la administración.
                Si te acaban de asignar permisos nuevos, cerrá sesión y volvé a ingresar
                para que se apliquen.
            </p>

            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-house-door"></i> Volver al inicio
            </a>

        </div>

    </div>

</div>