@{
    ViewData["Title"] = "Acceso denegado";
    ViewData["OcultarEncabezado"] = true;
}

<div class="card card-narrow text-center mt-4">
    <div class="card-body p-4">
        <div class="hero-badge"><i class="bi bi-shield-lock" aria-hidden="true"></i></div>
        <h1 class="h3">Acceso denegado</h1>
        <p class="mb-2">Tu cuenta no tiene permisos para acceder a esta sección.</p>
        <p class="text-muted small mb-4">
            Si considerás que deberías tener acceso, solicitalo a la administración.
            Si te acaban de asignar permisos nuevos, cerrá sesión y volvé a ingresar
            para que se apliquen.
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-house-door" aria-hidden="true"></i> Volver al inicio
        </a>
    </div>
</div>
