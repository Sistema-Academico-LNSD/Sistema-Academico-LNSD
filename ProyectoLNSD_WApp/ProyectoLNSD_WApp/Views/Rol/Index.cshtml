@using ProyectoLNSD_WApp.BLL.DTO
@{
    ViewData["Title"] = "Roles";
    ViewData["Subtitle"] = "Administración de roles del sistema";
    ViewData["Icon"] = "bi-person-badge";
}

@section Acciones {
    @if (User.TienePermiso("Roles", "Crear"))
    {
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrearRol">
            <i class="bi bi-plus-circle"></i> Nuevo rol
        </button>
    }
}

<div class="card">
    <div class="card-body">

            <div class="table-responsive">

                <table id="tblRoles"
                       class="table table-striped table-hover">

                    <thead>

                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Acciones</th>
                        </tr>

                    </thead>

                    <tbody>
                    </tbody>

                </table>

            </div>

        </div>

    </div>



@await Html.PartialAsync("_Create", new RolDTO())

@await Html.PartialAsync("_Edit", new RolDTO())

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/rol.js" asp-append-version="true"></script>

}