@{
    ViewData["Title"] = "Supervisión de recursos";
    ViewData["Subtitle"] = "Contenido educativo publicado, por docente y curso";
    ViewData["Icon"] = "bi-card-checklist";
}

@section Acciones {
    <button type="button" id="btnExportarSupervision" class="btn btn-outline-primary">
        <i class="bi bi-file-earmark-excel"></i> Exportar
    </button>
}

<div class="card">
    <div class="card-body">

            <div class="row g-2 mb-3">

                <div class="col-md-4">
                    <label for="svDocente" class="form-label small mb-1">Docente</label>
                    <select id="svDocente" class="form-select">
                        <option value="">Todos los docentes</option>
                    </select>
                </div>

                <div class="col-md-5">
                    <label for="svCurso" class="form-label small mb-1">Curso</label>
                    <select id="svCurso" class="form-select">
                        <option value="">Todos los cursos</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="button" id="btnLimpiarSupervision" class="btn btn-outline-secondary">
                        Limpiar filtros
                    </button>
                </div>

            </div>

            <div class="mb-2">
                <span id="svResumen" class="badge bg-secondary"></span>
            </div>

            <div class="table-responsive">

                <table id="tblSupervision" class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Curso</th>
                            <th>Grado</th>
                            <th>Recurso</th>
                            <th>Tipo</th>
                            <th>Contenido</th>
                            <th>Publicado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td colspan="7" class="text-center text-muted">Cargando...</td>
                        </tr>
                    </tbody>

                </table>

            </div>

        </div>

    </div>



@section Scripts {

    <script src="~/js/recurso-comun.js" asp-append-version="true"></script>
    <script src="~/js/supervision.js" asp-append-version="true"></script>

}