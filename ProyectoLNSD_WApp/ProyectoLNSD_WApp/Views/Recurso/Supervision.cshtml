@{
    ViewData["Title"] = "Supervisión de Recursos";
}

<div class="container-fluid mt-4">

    <div class="card shadow border-0">

        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <div>
                <h3 class="mb-0">
                    <i class="bi bi-card-checklist"></i>
                    Supervisión de recursos académicos
                </h3>
                <small>Contenido educativo publicado, por docente y curso</small>
            </div>

            <button type="button" id="btnExportarSupervision" class="btn btn-light">
                <i class="bi bi-file-earmark-excel"></i>
                Exportar
            </button>
        </div>

        <div class="card-body">

            <div class="row g-2 mb-3">

                <div class="col-md-4">
                    <label for="svDocente" class="form-label small mb-1">Docente</label>
                    <select id="svDocente" class="form-select">
                        <option value="">Todos los docentes</option>
                    </select>
                </div>

                <div class="col-md-5">
                    <label for="svCurso" class="form-label small mb-1">Curso</label>
                    <select id="svCurso" class="form-select">
                        <option value="">Todos los cursos</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="button" id="btnLimpiarSupervision" class="btn btn-outline-secondary">
                        Limpiar filtros
                    </button>
                </div>

            </div>

            <div class="mb-2">
                <span id="svResumen" class="badge bg-secondary"></span>
            </div>

            <div class="table-responsive">

                <table id="tblSupervision" class="table table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Curso</th>
                            <th>Grado</th>
                            <th>Recurso</th>
                            <th>Tipo</th>
                            <th>Contenido</th>
                            <th>Publicado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td colspan="7" class="text-center text-muted">Cargando...</td>
                        </tr>
                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script src="~/js/recurso-comun.js"></script>
    <script src="~/js/supervision.js"></script>

}