@{
    ViewData["Title"] = "Material de estudio";
    ViewData["Subtitle"] = "Recursos publicados por tus docentes";
    ViewData["Icon"] = "bi-journal-bookmark";
}

<div class="card">
    <div class="card-body">

            <div class="row g-2 mb-3">

                <div class="col-md-4">
                    <label for="mtGrado" class="form-label small mb-1">Grado</label>
                    <select id="mtGrado" class="form-select"></select>
                </div>

                <div class="col-md-5">
                    <label for="mtCurso" class="form-label small mb-1">Curso</label>
                    <select id="mtCurso" class="form-select">
                        <option value="">Todos los cursos</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <button type="button" id="btnLimpiarMaterial" class="btn btn-outline-secondary">
                        Limpiar filtros
                    </button>
                </div>

            </div>

            <div class="table-responsive">

                <table id="tblMaterial" class="table table-striped table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Recurso</th>
                            <th>Curso</th>
                            <th>Tipo</th>
                            <th>Docente</th>
                            <th>Publicado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td colspan="6" class="text-center text-muted">Cargando...</td>
                        </tr>
                    </tbody>

                </table>

            </div>

        </div>

    </div>



<div class="modal fade" id="modalDetalleMaterial" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-info-circle"></i>
                    Detalle del recurso
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">

                <h5 id="dtTitulo" class="mb-1"></h5>
                <p id="dtDescripcion" class="text-muted"></p>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Curso</dt>
                    <dd class="col-sm-8" id="dtCurso"></dd>

                    <dt class="col-sm-4">Grado</dt>
                    <dd class="col-sm-8" id="dtGrado"></dd>

                    <dt class="col-sm-4">Tipo</dt>
                    <dd class="col-sm-8" id="dtTipo"></dd>

                    <dt class="col-sm-4">Docente</dt>
                    <dd class="col-sm-8" id="dtDocente"></dd>

                    <dt class="col-sm-4">Publicado</dt>
                    <dd class="col-sm-8" id="dtFecha"></dd>

                    <dt class="col-sm-4">Contenido</dt>
                    <dd class="col-sm-8" id="dtContenido"></dd>
                </dl>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>

                <button type="button" id="btnDetalleDescargar" class="btn btn-primary d-none">
                    <i class="bi bi-download"></i> Descargar
                </button>

                <a id="lnkDetalleAbrir" class="btn btn-primary d-none" target="_blank" rel="noopener noreferrer">
                    <i class="bi bi-box-arrow-up-right"></i> Abrir enlace
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {

    <script src="~/js/recurso-comun.js" asp-append-version="true"></script>
    <script src="~/js/material.js" asp-append-version="true"></script>

}