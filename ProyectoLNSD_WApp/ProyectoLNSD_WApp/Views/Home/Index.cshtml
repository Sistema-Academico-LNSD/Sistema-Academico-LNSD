@model ProyectoLNSD_WApp.BLL.DTO.LandingDTO
@{
    ViewData["Title"] = "Inicio";
    ViewData["OcultarEncabezado"] = true;

    bool autenticado = User.Identity?.IsAuthenticated == true;
    string? nombreUsuario = User.Identity?.Name;
    string? rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}

@if (autenticado)
{
    @* Panel de inicio: los módulos están en el menú lateral; aquí solo bienvenida y accesos rápidos. *@
    <section class="welcome">
        <div>
            <h1>Bienvenido, @nombreUsuario</h1>
        </div>
        @if (!string.IsNullOrWhiteSpace(rolUsuario))
        {
            <span class="badge-rol"><i class="bi bi-person-check" aria-hidden="true"></i> @rolUsuario</span>
        }
    </section>

    @* Accesos rápidos: los administra Configuración > Accesos rápidos y se asignan por rol *@
    @if (Model.Accesos.Count > 0)
    {
        <section class="mb-4">
            <h2 class="section-title"><i class="bi bi-grid-1x2" aria-hidden="true"></i> Accesos rápidos</h2>

            <div class="module-grid">
                @foreach (var acceso in Model.Accesos)
                {
                    bool externo = acceso.Enlace.StartsWith("http", StringComparison.OrdinalIgnoreCase);

                    <a href="@acceso.Enlace" class="module-card"
                       target="@(externo ? "_blank" : null)" rel="@(externo ? "noopener noreferrer" : null)">
                        <div class="module-icon">
                            <i class="bi @(string.IsNullOrWhiteSpace(acceso.Icono) ? "bi-link-45deg" : acceso.Icono)" aria-hidden="true"></i>
                        </div>
                        <h3>@acceso.Nombre</h3>
                        @if (!string.IsNullOrWhiteSpace(acceso.Descripcion))
                        {
                            <p>@acceso.Descripcion</p>
                        }
                    </a>
                }
            </div>
        </section>
    }
}
else
{
    <section class="hero-lnsd">
        <div class="hero-lnsd-content">
            <span class="hero-badge"><i class="bi bi-mortarboard-fill" aria-hidden="true"></i></span>
            <h1>Sistema Académico LNSD</h1>
            <p class="hero-subtitle">
                Bienvenidos a la plataforma digital de gestión académica, administrativa
                y de seguridad del Liceo Nuevo de Santo Domingo.
            </p>
            <a asp-controller="Auth" asp-action="Login" class="btn btn-accent btn-lg mt-2">
                <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Iniciar sesión
            </a>
        </div>
    </section>
}

@* Banners publicados (carrusel) *@
<partial name="_BannersSitio" model="Model" />

@* Bloques, misión/visión/historia y contacto (solo lo publicado) *@
<partial name="_ContenidoSitio" model="Model" />
