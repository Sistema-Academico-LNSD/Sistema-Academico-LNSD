
@model ProyectoLNSD_WApp.BLL.DTO.LandingDTO
@{
    ViewData["Title"] = "Inicio";

    bool autenticado = User.Identity?.IsAuthenticated == true;
    bool esAdmin = User.IsInRole("Administrador");
    string? nombreUsuario = User.Identity?.Name;
    string? rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}

<!-- -----------------------------------------
     HERO Section
---------------------------------------------- -->
<section class="hero-lnsd">
    <div class="hero-lnsd-content">

        <span class="hero-badge">
            <i class="bi bi-mortarboard-fill"></i>
        </span>

        @if (autenticado)
        {
            <h1>Bienvenido, @nombreUsuario</h1>
            <p class="hero-subtitle">
                @if (!string.IsNullOrWhiteSpace(rolUsuario))
                {
                    <span class="badge-rol"><i class="bi bi-person-check"></i> @rolUsuario</span>
                }
                Accedé a los módulos habilitados para tu cuenta desde el panel de abajo.
            </p>
        }
        else
        {
            <h1>Sistema Académico LNSD</h1>
            <p class="hero-subtitle">
                Bienvenidos a la plataforma digital de gestión académica, administrativa
                y de seguridad del Liceo Nuevo de Santo Domingo.
            </p>
            <a asp-controller="Auth" asp-action="Login" class="btn btn-login-nav btn-lg mt-3">
                <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
            </a>
        }

    </div>
</section>


<!-- -----------------------------------------
     Quick Access Modules
---------------------------------------------- -->
@if (autenticado)
{
    <section class="mt-4">

        <h2 class="section-title">
            <i class="bi bi-grid-1x2"></i>
            Accesos rápidos
        </h2>

        <div class="module-grid">

            @if (User.TienePermiso("Usuarios", "Ver"))
            {
                <a asp-controller="Usuario" asp-action="Index" class="module-card">
                    <div class="module-icon"><i class="bi bi-people"></i></div>
                    <h3>Usuarios</h3>
                    <p>Edición y activación de cuentas del sistema.</p>
                </a>
            }

            @if (User.TienePermiso("Roles", "Ver"))
            {
                <a asp-controller="Rol" asp-action="Index" class="module-card">
                    <div class="module-icon"><i class="bi bi-person-badge"></i></div>
                    <h3>Roles</h3>
                    <p>Roles y descripción dentro del sistema.</p>
                </a>
            }

            @if (esAdmin)
            {
                <a asp-controller="Permiso" asp-action="Index" class="module-card">
                    <div class="module-icon"><i class="bi bi-shield-lock"></i></div>
                    <h3>Permisos</h3>
                    <p>Permisos para cada rol.</p>
                </a>

                <a asp-controller="Auditoria" asp-action="Index" class="module-card">
                    <div class="module-icon"><i class="bi bi-journal-text"></i></div>
                    <h3>Historial de Accesos</h3>
                    <p>Auditoría de sesión.</p>
                </a>
            }

            @if (User.TienePermiso("Configuracion", "Ver"))
            {
                <a asp-controller="Configuracion" asp-action="Index" class="module-card">
                    <div class="module-icon"><i class="bi bi-gear"></i></div>
                    <h3>Configuración</h3>
                    <p>Datos institucionales, períodos y contenido del sitio.</p>
                </a>
            }

        </div>

    </section>
}

<!-- -----------------------------------------
     Información institucional (solo contenido publicado) - MCFG-01-05
---------------------------------------------- -->
@if (Model.Bloques.Count > 0)
{
    <section class="mt-5">
        <div class="row g-3">
            @foreach (var bloque in Model.Bloques)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <h3 class="h5">@bloque.Titulo</h3>
                            <p class="mb-0" style="white-space: pre-line;">@bloque.Descripcion</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

@if (Model.Mision != null || Model.Vision != null || Model.Historia != null)
{
    <section class="mt-5">
        <h2 class="section-title">
            <i class="bi bi-info-circle"></i>
            Quiénes somos
        </h2>

        <div class="row g-3">
            @foreach (var bloque in new[] { Model.Mision, Model.Vision, Model.Historia })
            {
                if (bloque == null) { continue; }

                <div class="@(bloque.Tipo == "Historia" ? "col-12" : "col-md-6")">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <h3 class="h5">@bloque.Titulo</h3>
                            <p class="mb-0" style="white-space: pre-line;">@bloque.Descripcion</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

@if (Model.Institucion != null)
{
    <section class="mt-5 mb-4">
        <h2 class="section-title">
            <i class="bi bi-telephone"></i>
            Contacto
        </h2>

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h3 class="h5">@Model.Institucion.Nombre</h3>
                <ul class="list-unstyled mb-0">
                    @if (!string.IsNullOrWhiteSpace(Model.Institucion.Direccion))
                    {
                        <li><i class="bi bi-geo-alt"></i> @Model.Institucion.Direccion</li>
                    }
                    <li><i class="bi bi-telephone"></i> @Model.Institucion.Telefono</li>
                    @if (!string.IsNullOrWhiteSpace(Model.Institucion.TelefonoSecundario))
                    {
                        <li><i class="bi bi-telephone"></i> @Model.Institucion.TelefonoSecundario</li>
                    }
                    <li><i class="bi bi-envelope"></i> @Model.Institucion.Correo</li>
                </ul>
            </div>
        </div>
    </section>
}
