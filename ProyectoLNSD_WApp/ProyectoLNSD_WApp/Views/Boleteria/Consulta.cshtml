@{
    ViewData["Title"] = "Control de tiquetes";
    ViewData["Subtitle"] = "Uso del servicio de comedor";
    ViewData["Icon"] = "bi-clipboard-data";
}

@section Acciones {
    <button type="button" id="btnActualizar" class="btn btn-outline-primary">
        <i class="bi bi-arrow-clockwise"></i> Actualizar
    </button>
}

<div class="row g-3 mb-4">

    <div class="col-md-4">
        <div class="card stat-card">
            <div class="card-body">
                <span class="stat-icon"><i class="bi bi-ticket-perforated"></i></span>
                <div>
                    <div class="stat-value" id="cntGenerados">0</div>
                    <div class="stat-label">Tiquetes generados</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card stat-card">
            <div class="card-body">
                <span class="stat-icon text-success"><i class="bi bi-hourglass-split"></i></span>
                <div>
                    <div class="stat-value" id="cntDisponibles">0</div>
                    <div class="stat-label">Disponibles</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card stat-card">
            <div class="card-body">
                <span class="stat-icon text-secondary"><i class="bi bi-check-circle"></i></span>
                <div>
                    <div class="stat-value" id="cntUtilizados">0</div>
                    <div class="stat-label">Utilizados</div>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center gap-2">
        <h2>Tiquetes</h2>
        <div class="d-flex align-items-center gap-2">
            <label for="cmbEstado" class="form-label mb-0 fw-normal">Estado</label>
            <select id="cmbEstado" class="form-select form-select-sm w-auto">
                <option value="">Todos</option>
                <option value="Disponible">Disponible</option>
                <option value="Utilizado">Utilizado</option>
            </select>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="tblTiquetes" class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Usuario</th>
                        <th>Estado</th>
                        <th>Generado</th>
                        <th>Utilizado</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/boleteria-comun.js" asp-append-version="true"></script>
    <script src="~/js/boleteria-consulta.js" asp-append-version="true"></script>
}
