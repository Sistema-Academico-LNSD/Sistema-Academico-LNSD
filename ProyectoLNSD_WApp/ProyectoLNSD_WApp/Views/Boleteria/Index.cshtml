@{
    ViewData["Title"] = "Mi Tiquete";
}

<div class="container-fluid mt-4">

    <div class="card shadow border-0 mb-4">

        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h3 class="mb-0">
                        <i class="bi bi-ticket-perforated"></i>
                        Mi Tiquete
                    </h3>

                    <small>
                        Tiquete digital para el acceso al comedor
                    </small>
                </div>

                <button type="button" id="btnGenerarTiquete" class="btn btn-light">
                    <i class="bi bi-plus-circle"></i>
                    Generar tiquete
                </button>

            </div>
        </div>

        <div class="card-body" id="tiqueteActual">
            <p class="text-muted mb-0">Cargando...</p>
        </div>

    </div>

    <div class="card shadow border-0">

        <div class="card-header">
            <h5 class="mb-0">
                <i class="bi bi-clock-history"></i>
                Mis tiquetes
            </h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table id="tblTiquetes" class="table table-striped table-hover">

                    <thead class="table-dark">
                        <tr>
                            <th>Código</th>
                            <th>Estado</th>
                            <th>Generado</th>
                            <th>Utilizado</th>
                        </tr>
                    </thead>

                    <tbody>
                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script src="~/js/boleteria-comun.js"></script>
    <script src="~/js/boleteria.js"></script>

}