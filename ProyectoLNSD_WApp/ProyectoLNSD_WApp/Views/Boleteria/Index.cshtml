@{
    ViewData["Title"] = "Mi tiquete";
    ViewData["Subtitle"] = "Tiquete digital para el acceso al comedor";
    ViewData["Icon"] = "bi-ticket-perforated";
}

@section Acciones {
    <button type="button" id="btnGenerarTiquete" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Generar tiquete
    </button>
}

<div class="card mb-4">
    <div class="card-header">
        <h2><i class="bi bi-ticket-perforated"></i> Tiquete actual</h2>
    </div>
    <div class="card-body" id="tiqueteActual">
        <p class="text-muted mb-0">Cargando...</p>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2><i class="bi bi-clock-history"></i> Mis tiquetes</h2>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="tblTiquetes" class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Estado</th>
                        <th>Generado</th>
                        <th>Utilizado</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/boleteria-comun.js" asp-append-version="true"></script>
    <script src="~/js/boleteria.js" asp-append-version="true"></script>
}
