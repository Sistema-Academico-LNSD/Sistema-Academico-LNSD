@{
    ViewData["Title"] = "Horarios por docente";
    ViewData["Subtitle"] = "Clases asignadas a cada profesor";
    ViewData["Icon"] = "bi-person-lines-fill";
}

<div class="card">

    <div class="card-header d-flex justify-content-between align-items-center">
        <h2><i class="bi bi-calendar-week"></i> Horario semanal del docente</h2>
        <span id="pdContador" class="badge bg-secondary"></span>
    </div>

    <div class="card-body">

        <div class="row g-2 mb-3">

            <div class="col-md-5">
                <label for="pdDocente" class="form-label small mb-1">Docente</label>
                <select id="pdDocente" class="form-select form-select-sm">
                    <option value="">Cargando...</option>
                </select>
            </div>

            <div class="col-md-4">
                <label for="pdPeriodo" class="form-label small mb-1">Período lectivo</label>
                <select id="pdPeriodo" class="form-select form-select-sm"></select>
            </div>

        </div>

        <div id="pdCuadricula"></div>

    </div>

</div>

@section Scripts {

    <script src="~/js/horario-semana.js" asp-append-version="true"></script>
    <script src="~/js/por-docente.js" asp-append-version="true"></script>

}