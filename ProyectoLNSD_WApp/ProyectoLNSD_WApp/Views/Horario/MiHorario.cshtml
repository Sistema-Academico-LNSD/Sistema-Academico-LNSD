@{
    ViewData["Title"] = "Mi horario";
    ViewData["Subtitle"] = "Tus clases de la semana";
    ViewData["Icon"] = "bi-calendar-week";
}

<div class="card">

    <div class="card-header d-flex justify-content-between align-items-center">
        <h2><i class="bi bi-calendar-week"></i> Horario semanal</h2>
        <span id="mhContador" class="badge bg-secondary"></span>
    </div>

    <div class="card-body">

        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <label for="mhPeriodo" class="form-label small mb-1">Período lectivo</label>
                <select id="mhPeriodo" class="form-select form-select-sm"></select>
            </div>
        </div>

        <div id="mhCuadricula">
            <p class="text-center text-muted mb-0">Cargando...</p>
        </div>

    </div>

</div>

@section Scripts {

    <script src="~/js/horario-semana.js" asp-append-version="true"></script>
    <script src="~/js/mi-horario.js" asp-append-version="true"></script>

}