@{
    ViewData["Title"] = "Pautas de actuación";
    ViewData["Subtitle"] = "Expedientes de las pautas de actuación del MEP";
    ViewData["Icon"] = "bi-folder2-open";

    bool puedeCrear = User.TienePermiso("Pautas", "Crear");
}

<link rel="stylesheet" href="~/css/pauta.css" asp-append-version="true" />

@section Acciones {
    @if (puedeCrear)
    {
        <a asp-controller="Pauta" asp-action="Nueva" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Nueva pauta
        </a>
    }
}

<div class="alert alert-warning py-2 small d-flex align-items-center gap-2">
    <i class="bi bi-shield-lock"></i>
    <span>La información de esta sección es confidencial. Trátela con discreción; cada consulta, edición y descarga queda registrada.</span>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label for="fPauta" class="form-label small mb-1">Pauta</label>
                <select id="fPauta" class="form-select">
                    <option value="">Todas</option>
                </select>
            </div>
            <div class="col-md-2">
                <label for="fEstado" class="form-label small mb-1">Estado</label>
                <select id="fEstado" class="form-select">
                    <option value="">Todos</option>
                    <option value="Abierto">Abiertos</option>
                    <option value="Cerrado">Cerrados</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="fEstudiante" class="form-label small mb-1">Persona estudiante</label>
                <input id="fEstudiante" class="form-control" maxlength="100" placeholder="Nombre..." />
            </div>
            <div class="col-md-2">
                <label for="fDesde" class="form-label small mb-1">Desde</label>
                <input id="fDesde" type="date" class="form-control" />
            </div>
            <div class="col-md-2">
                <label for="fHasta" class="form-label small mb-1">Hasta</label>
                <input id="fHasta" type="date" class="form-control" />
            </div>
        </div>
        <div class="mt-2 text-end">
            <button type="button" id="btnLimpiar" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-x-circle"></i> Limpiar filtros
            </button>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle" id="tblExpedientes">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Pauta</th>
                        <th>Personas estudiantes</th>
                        <th>Responsable</th>
                        <th>Activada</th>
                        <th>Formularios</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td colspan="8" class="text-center text-muted">Cargando...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pauta-comun.js" asp-append-version="true"></script>
    <script src="~/js/pauta-index.js" asp-append-version="true"></script>
}
