@{
    ViewData["Title"] = "Requisitos de beca";
    ViewData["Subtitle"] = "Criterios de elegibilidad para becas socioeconómicas";
    ViewData["Icon"] = "bi-list-check";
}

@section Acciones {
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Becas
    </a>
    <button type="button" id="btnNuevoRequisito" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nuevo requisito
    </button>
}

<div class="alert alert-info small">
    <i class="bi bi-info-circle"></i>
    Los requisitos <strong>obligatorios</strong> se exigen para activar una beca. Un requisito desactivado deja de exigirse,
    pero se conserva en las becas que ya lo tenían marcado. Las becas activas no cambian solas: la lista de becas
    señala las que dejaron de cumplir para que se revisen.
</div>

<div class="card">
    <div class="card-body">
        <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="rVerInactivos" />
            <label class="form-check-label small" for="rVerInactivos">Mostrar requisitos desactivados</label>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle" id="tblRequisitos">
                <thead>
                    <tr>
                        <th>Requisito</th>
                        <th>Tipo</th>
                        <th>Verificación</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td colspan="5" class="text-center text-muted">Cargando...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalRequisito" tabindex="-1" aria-labelledby="modalRequisitoTitulo" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalRequisitoTitulo">Nuevo requisito</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="formRequisito" novalidate>
                    <input type="hidden" id="rId" value="0" />
                    <div class="mb-3">
                        <label for="rNombre" class="form-label">Nombre</label>
                        <input id="rNombre" class="form-control" maxlength="150" required />
                    </div>
                    <div class="mb-3">
                        <label for="rDescripcion" class="form-label">Descripción <span class="text-muted small">(opcional)</span></label>
                        <textarea id="rDescripcion" class="form-control" rows="3" maxlength="500"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="rVerificacion" class="form-label">¿Quién lo verifica?</label>
                        <select id="rVerificacion" class="form-select">
                            <option value="">El administrador lo marca en cada beca</option>
                            <option value="MatriculaActiva">El sistema: matrícula activa en el período de la beca</option>
                        </select>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="rObligatorio" checked />
                        <label class="form-check-label" for="rObligatorio">Obligatorio para activar la beca</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnGuardarRequisito" class="btn btn-primary">
                    <i class="bi bi-save"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/beca-requisitos.js" asp-append-version="true"></script>
}
