@{
    ViewData["Title"] = "Grupos académicos";
    ViewData["Subtitle"] = "Subdivisiones A/B usadas para materias que requieren separar una sección";
    ViewData["Icon"] = "bi-people-fill";
    bool puedeCrear = User.TienePermiso("Grados", "Crear");
}

@section Acciones {
    @if (puedeCrear)
    {
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalGrupo">
            <i class="bi bi-plus-circle"></i> Crear grupo
        </button>
    }
}

<div class="alert alert-info">
    <strong>Cómo se usan:</strong> por ejemplo, para el período 2026 puede crear los grupos <b>A</b> y <b>B</b>
    para el nivel correspondiente. La matrícula combina el grupo elegido con la sección (por ejemplo, 7-1).
    El mismo grupo A/B puede reutilizarse para las distintas materias que dividen a los estudiantes de esa sección.
    <br />
    <span class="small">
        Actualmente, el modelo guarda el grupo por nombre, nivel y año; la relación concreta con la sección
        se establece en cada matrícula.
    </span>
</div>

<div id="alertaGrupos" class="alert d-none" role="alert"></div>

<div class="card">
    <div class="card-body">

        <div class="row g-2 filter-bar">
            <div class="col-sm-4 col-md-3">
                <label for="fAnio" class="form-label">Filtrar por año</label>
                <select id="fAnio" class="form-select">
                    <option value="">Todos los años</option>
                </select>
            </div>
            <div class="col-sm-4 col-md-3 d-flex align-items-end">
                <button type="button" id="btnActualizar" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-clockwise"></i> Actualizar
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Nivel</th>
                        <th>Año</th>
                        <th>Uso previsto</th>
                    </tr>
                </thead>
                <tbody id="tablaGrupos">
                    <tr><td colspan="4" class="text-center text-muted">Cargando grupos...</td></tr>
                </tbody>
            </table>
        </div>

    </div>
</div>

@if (puedeCrear)
{
    <div class="modal fade" id="modalGrupo" tabindex="-1" aria-hidden="true" aria-labelledby="tituloModalGrupo">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="formGrupo">

                    <div class="modal-header">
                        <h5 class="modal-title" id="tituloModalGrupo">Crear grupo</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>

                    <div class="modal-body">
                        @Html.AntiForgeryToken()
                        <div id="errorGrupo" class="alert alert-danger d-none"></div>

                        <div class="mb-3">
                            <label for="nombreGrupo" class="form-label">Nombre *</label>
                            <input id="nombreGrupo" name="nombre" class="form-control" maxlength="50" required placeholder="A" />
                            <div class="form-text">Puede usar A, B u otra etiqueta que utilice el centro.</div>
                        </div>

                        <div class="mb-3">
                            <label for="nivelGrupo" class="form-label">Nivel académico *</label>
                            <select id="nivelGrupo" name="nivel" class="form-select" required>
                                <option value="">Cargando niveles...</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="anioGrupo" class="form-label">Año lectivo *</label>
                            <input id="anioGrupo" name="anio" class="form-control" type="number" min="2000" max="2100"
                                   required value="@DateTime.Today.Year" />
                            <div class="form-text">Debe coincidir con el año de inicio del período lectivo usado en la matrícula.</div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar grupo</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/grupos.js" asp-append-version="true"></script>
}
