@model ProyectoLNSD_WApp.BLL.DTO.InstitucionDTO
@{
    ViewData["Title"] = "Configuración";
}

<div class="container-fluid mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0"><i class="bi bi-gear"></i> Configuración del sistema</h3>
            <small>Datos institucionales, períodos lectivos y contenido del sitio</small>
        </div>

        <div class="card-body">

            @* Cada HU agrega aquí su pestaña (y su panel más abajo) *@
            <ul class="nav nav-tabs mb-3" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabInstitucion" type="button">
                        <i class="bi bi-building"></i> Institución
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabPeriodos" type="button">
                        <i class="bi bi-calendar3"></i> Períodos lectivos
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabContenido" type="button">
                        <i class="bi bi-file-earmark-text"></i> Misión, visión e historia
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabBloques" type="button">
                        <i class="bi bi-layout-text-window"></i> Página principal
                    </button>
                </li>
            </ul>

            <div class="tab-content">

                <!-- HU 01: Institución -->
                <div class="tab-pane fade show active" id="tabInstitucion">
                    <form id="formInstitucion" enctype="multipart/form-data" novalidate>
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label asp-for="Nombre" class="form-label">Nombre de la institución *</label>
                                    <input asp-for="Nombre" class="form-control" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Direccion" class="form-label">Dirección</label>
                                    <input asp-for="Direccion" class="form-control" />
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Telefono" class="form-label">Teléfono principal *</label>
                                        <input asp-for="Telefono" class="form-control" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="TelefonoSecundario" class="form-label">Teléfono secundario</label>
                                        <input asp-for="TelefonoSecundario" class="form-control" />
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Correo" class="form-label">Correo institucional *</label>
                                    <input asp-for="Correo" class="form-control" />
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Logotipo</label>
                                <div class="mb-2">
                                    <img id="previewLogo" src="" alt="Logo actual"
                                         class="img-thumbnail d-none" style="max-height:160px;" />
                                </div>
                                <input type="file" name="logo" id="logo" class="form-control"
                                       accept=".jpg,.jpeg,.png,.webp" />
                                <div class="form-text">JPG, PNG o WEBP, máximo 2 MB.</div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted" id="lblActualizado"></small>
                            <button type="button" id="btnGuardarInstitucion" class="btn btn-primary">
                                <i class="bi bi-save"></i> Guardar
                            </button>
                        </div>
                    </form>
                </div>

                <!-- HU 02: Períodos lectivos -->
                <div class="tab-pane fade" id="tabPeriodos">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">Períodos lectivos</h5>
                        <button type="button" id="btnNuevoPeriodo" class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i> Nuevo período
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Inicio</th>
                                    <th>Fin</th>
                                    <th>Estado</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyPeriodos"></tbody>
                        </table>
                    </div>
                </div>

                <!-- HU 05: Misión, visión e historia -->
                <div class="tab-pane fade" id="tabContenido">
                    <div class="alert alert-info py-2">
                        <i class="bi bi-info-circle"></i>
                        Solo lo <strong>publicado</strong> se muestra en el sitio web. Los datos de contacto
                        (teléfonos, correo, dirección) se editan en la pestaña <strong>Institución</strong>.
                    </div>

                    @foreach (var (tipo, titulo, icono) in new[] {
                        ("Mision", "Misión", "bi-bullseye"),
                        ("Vision", "Visión", "bi-eye"),
                        ("Historia", "Historia", "bi-book") })
                    {
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h6 class="mb-0"><i class="bi @icono"></i> @titulo</h6>
                                <span id="estado-@tipo" class="badge bg-secondary">Sin contenido</span>
                            </div>
                            <div class="card-body">
                                <textarea id="texto-@tipo" class="form-control mb-2" rows="4" maxlength="5000"
                                          placeholder="Escriba aquí el texto de @titulo.ToLower()"></textarea>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted" id="fecha-@tipo"></small>
                                    <div>
                                        <button type="button" class="btn btn-outline-secondary btn-guardar-contenido"
                                                data-tipo="@tipo" data-publicar="false">
                                            <i class="bi bi-save"></i> Guardar borrador
                                        </button>
                                        <button type="button" class="btn btn-success btn-guardar-contenido"
                                                data-tipo="@tipo" data-publicar="true">
                                            <i class="bi bi-cloud-upload"></i> Publicar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- HU 04: Contenido de la página principal -->
                <div class="tab-pane fade" id="tabBloques">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">Contenido de la página principal</h5>
                        <button type="button" id="btnNuevoBloque" class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i> Nuevo contenido
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Orden</th>
                                    <th>Título</th>
                                    <th>Estado</th>
                                    <th>Actualizado</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyBloques"></tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Modal: crear / editar contenido de la página principal -->
<div class="modal fade" id="modalBloque" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="formBloque" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="IdContenido" id="bloqueId" value="0" />
                <input type="hidden" name="Tipo" value="Bloque" />
                <input type="hidden" id="bloqueEstado" value="" />

                <div class="modal-header">
                    <h5 class="modal-title" id="tituloModalBloque">Nuevo contenido</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="bloqueTitulo">Título *</label>
                        <input type="text" name="Titulo" id="bloqueTitulo" class="form-control" maxlength="150" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="bloqueDescripcion">Texto *</label>
                        <textarea name="Descripcion" id="bloqueDescripcion" class="form-control" rows="6" maxlength="5000"></textarea>
                    </div>
                    <div class="mb-3" style="max-width:180px;">
                        <label class="form-label" for="bloqueOrden">Orden de aparición</label>
                        <input type="number" name="Orden" id="bloqueOrden" class="form-control" min="0" value="0" />
                        <div class="form-text">Menor número aparece primero.</div>
                    </div>
                    <small class="text-muted">Solo lo publicado se muestra en la página principal.</small>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" id="btnBloqueBorrador" class="btn btn-outline-secondary">
                        <i class="bi bi-save"></i> Guardar borrador
                    </button>
                    <button type="button" id="btnBloquePublicar" class="btn btn-success">
                        <i class="bi bi-cloud-upload"></i> Publicar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: registrar / editar período -->
<div class="modal fade" id="modalPeriodo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="formPeriodo" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="IdPeriodo" id="periodoId" value="0" />

                <div class="modal-header">
                    <h5 class="modal-title" id="tituloModalPeriodo">Nuevo período lectivo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="periodoNombre">Nombre *</label>
                        <input type="text" name="Nombre" id="periodoNombre" class="form-control" maxlength="100"
                               placeholder="Ej: Curso lectivo 2026" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="periodoInicio">Fecha de inicio *</label>
                            <input type="date" name="FechaInicio" id="periodoInicio" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="periodoFin">Fecha de finalización *</label>
                            <input type="date" name="FechaFin" id="periodoFin" class="form-control" />
                        </div>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="Activo" id="periodoActivo" value="true" />
                        <label class="form-check-label" for="periodoActivo">Período activo</label>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" id="btnGuardarPeriodo" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/configuracion.js" asp-append-version="true"></script>
    <script src="~/js/configuracion-periodos.js" asp-append-version="true"></script>
    <script src="~/js/configuracion-contenido.js" asp-append-version="true"></script>
    <script src="~/js/configuracion-bloques.js" asp-append-version="true"></script>
}

