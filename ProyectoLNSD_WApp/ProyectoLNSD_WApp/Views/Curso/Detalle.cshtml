@model ProyectoLNSD_WApp.BLL.DTO.Curso.CursoDetalleDTO
@{
    ViewData["Title"] = "Detalle del curso";
    ViewData["Icon"] = "bi-book";
}

@section Acciones {
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Volver
    </a>
}

<div class="card">
    <div class="card-header">
        <h2>@Model.Curso.Codigo · @Model.Curso.Nombre</h2>
    </div>
    <div class="card-body">

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="data-label">Código</div>
                <div>@Model.Curso.Codigo</div>
            </div>
            <div class="col-md-6">
                <div class="data-label">Nombre</div>
                <div>@Model.Curso.Nombre</div>
            </div>
            <div class="col-12">
                <div class="data-label">Descripción</div>
                <div class="pre-line">@Model.Curso.Descripcion</div>
            </div>
            <div class="col-md-6">
                <div class="data-label">Área académica</div>
                <div>@(Model.Area?.Nombre ?? "Sin área")</div>
            </div>
            <div class="col-md-6">
                <div class="data-label">Estado</div>
                <div>
                    @if (Model.Curso.Estado)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </div>
            </div>
        </div>

        <h3 class="section-heading"><i class="bi bi-mortarboard"></i> Grados asociados</h3>

        @if (Model.Grados != null && Model.Grados.Any())
        {
            <div class="list-group">
                @foreach (ProyectoLNSD_WApp.BLL.DTO.GradoDTO grado in Model.Grados)
                {
                    <div class="list-group-item">
                        <strong>@grado.Codigo</strong> - @grado.Nombre
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted mb-0">No hay grados asociados.</p>
        }

    </div>
</div>
