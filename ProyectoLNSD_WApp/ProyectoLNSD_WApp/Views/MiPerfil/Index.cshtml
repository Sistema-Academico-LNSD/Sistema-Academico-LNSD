@model ProyectoLNSD_WApp.BLL.DTO.ExpedienteDocenteDTO?
@{
    ViewData["Title"] = "Mi perfil docente";
    ViewData["Subtitle"] = "Información personal, profesional y cursos asignados";
    ViewData["Icon"] = "bi-person-video3";
}

@section Acciones {
    @if (Model != null)
    {
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer"></i> Imprimir
        </button>
    }
}

@if (Model == null)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle"></i>
        @(ViewData["Mensaje"] ?? "No se encontró un expediente docente asociado a su cuenta.")
        Comuníquese con la administración de la institución.
    </div>
}
else
{
    <div class="alert alert-info small no-print">
        <i class="bi bi-info-circle"></i>
        Revisá que tus datos sean correctos. Si encontrás algún error, comunicalo
        a la administración del liceo para que lo actualice en tu expediente.
    </div>

    @await Html.PartialAsync("_ExpedienteDocente", Model)
}
