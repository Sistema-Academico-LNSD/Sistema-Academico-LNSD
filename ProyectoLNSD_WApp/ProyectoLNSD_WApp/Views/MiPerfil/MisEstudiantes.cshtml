@using ProyectoLNSD_WApp.BLL.DTO
@model RespuestaDTO<List<EstudianteEncargadoDTO>>
@{
    ViewData["Title"] = "Mis estudiantes";
    ViewData["Subtitle"] = "Información básica de los estudiantes asociados a su cuenta";
    ViewData["Icon"] = "bi-people";
    var estudiantes = Model.Dato ?? new List<EstudianteEncargadoDTO>();
}

@if (estudiantes.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i>
        Aún no tiene estudiantes asociados a su cuenta. Comuníquese con la administración de la institución.
    </div>
}

@foreach (var e in estudiantes)
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2>@e.Nombre @e.Apellidos</h2>
            <span>
                @if (e.EsPrincipal)
                {
                    <span class="badge bg-warning text-dark me-1">
                        <i class="bi bi-star-fill"></i> Encargado principal
                    </span>
                }
                <span class="badge @(e.Estado ? "bg-success" : "bg-danger")">
                    @(e.Estado ? "Activo" : "Inactivo")
                </span>
            </span>
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="data-label">Carné</div>
                    <div>@e.Carnet</div>
                </div>
                <div class="col-md-3">
                    <div class="data-label">Identificación</div>
                    <div>@e.Identificacion</div>
                </div>
                <div class="col-md-3">
                    <div class="data-label">Fecha de nacimiento</div>
                    <div>@(e.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "—")</div>
                </div>
                <div class="col-md-3">
                    <div class="data-label">Su parentesco</div>
                    <div>@e.Parentesco</div>
                </div>
                <div class="col-md-3">
                    <div class="data-label">Grado</div>
                    <div>@(e.NombreGrado ?? "—")</div>
                </div>
                <div class="col-md-3">
                    <div class="data-label">Estado académico</div>
                    <div>@e.EstadoAcademico</div>
                </div>
                <div class="col-md-3">
                    <div class="data-label">Fecha de ingreso</div>
                    <div>@e.FechaIngreso.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
        </div>
    </div>
}
