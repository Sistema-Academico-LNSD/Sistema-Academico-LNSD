@using ProyectoLNSD_WApp.BLL.DTO
@model RespuestaDTO<EstudianteDTO?>
@{
    ViewData["Title"] = "Mi información";
    ViewData["Subtitle"] = "Datos institucionales registrados en el sistema";
    ViewData["Icon"] = "bi-person-vcard";
    var e = Model.Dato;
}

@if (!Model.EsCorrecto || e == null)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle"></i>
        @(Model.Mensaje ?? "No se encontró su información.")
        Comuníquese con la administración de la institución.
    </div>
}
else
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h2>@e.Nombre @e.Apellidos</h2>
                <span class="text-muted small fw-normal">Carné: <strong>@e.Carnet</strong></span>
            </div>
            <span class="badge @(e.Estado ? "bg-success" : "bg-danger")">
                @(e.Estado ? "Activo" : "Inactivo")
            </span>
        </div>

        <div class="card-body">

            <h3 class="section-heading"><i class="bi bi-person"></i> Información personal</h3>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="data-label">Identificación</div>
                    <div>@e.Identificacion</div>
                </div>
                <div class="col-md-4">
                    <div class="data-label">Fecha de nacimiento</div>
                    <div>@(e.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "—")</div>
                </div>
                <div class="col-md-4">
                    <div class="data-label">Teléfono</div>
                    <div>@(string.IsNullOrWhiteSpace(e.Telefono) ? "—" : e.Telefono)</div>
                </div>
                <div class="col-md-4">
                    <div class="data-label">Correo</div>
                    <div>@e.Correo</div>
                </div>
                <div class="col-md-4">
                    <div class="data-label">Correo de emergencia</div>
                    <div>@(string.IsNullOrWhiteSpace(e.CorreoEmergencia) ? "—" : e.CorreoEmergencia)</div>
                </div>
                <div class="col-md-4">
                    <div class="data-label">Dirección</div>
                    <div>@(string.IsNullOrWhiteSpace(e.Direccion) ? "—" : e.Direccion)</div>
                </div>
            </div>

            <h3 class="section-heading"><i class="bi bi-mortarboard"></i> Información académica</h3>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="data-label">Grado</div>
                    <div>@(e.NombreGrado ?? "—")</div>
                </div>
                <div class="col-md-4">
                    <div class="data-label">Estado académico</div>
                    <div>@e.EstadoAcademico</div>
                </div>
                <div class="col-md-4">
                    <div class="data-label">Fecha de ingreso</div>
                    <div>@(e.FechaIngreso?.ToString("dd/MM/yyyy") ?? "—")</div>
                </div>
            </div>

            <p class="text-muted small mt-4 mb-0">
                <i class="bi bi-info-circle"></i>
                Si algún dato es incorrecto, solicite la corrección a la administración.
            </p>
        </div>
    </div>
}
