@using ProyectoLNSD_WApp.BLL.DTO
@model RespuestaDTO<EstudianteDTO?>

@{
    ViewData["Title"] = "Mi información";
    var e = Model.Dato;
}

<div class="container mt-4">

    @if (!Model.EsCorrecto || e == null)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i>
            @(Model.Mensaje ?? "No se encontró su información.")
            Comuníquese con la administración de la institución.
        </div>
    }
    else
    {
        <div class="card shadow border-0 mb-4">
            <div class="card-header bg-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="mb-0"><i class="bi bi-person-vcard"></i> Mi información</h3>
                        <small>Datos institucionales registrados en el sistema</small>
                    </div>
                    <span class="badge @(e.Estado ? "bg-success" : "bg-danger") fs-6">
                        @(e.Estado ? "Activo" : "Inactivo")
                    </span>
                </div>
            </div>

            <div class="card-body">
                <h4 class="mb-0">@e.Nombre @e.Apellidos</h4>
                <p class="text-muted">Carné: <strong>@e.Carnet</strong></p>

                <h6 class="text-primary border-bottom pb-1 mt-4 mb-3">
                    <i class="bi bi-person"></i> Información personal
                </h6>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="text-muted small">Identificación</div>
                        <div>@e.Identificacion</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Fecha de nacimiento</div>
                        <div>@(e.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "—")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Teléfono</div>
                        <div>@(string.IsNullOrWhiteSpace(e.Telefono) ? "—" : e.Telefono)</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Correo</div>
                        <div>@e.Correo</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Correo de emergencia</div>
                        <div>@(string.IsNullOrWhiteSpace(e.CorreoEmergencia) ? "—" : e.CorreoEmergencia)</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Dirección</div>
                        <div>@(string.IsNullOrWhiteSpace(e.Direccion) ? "—" : e.Direccion)</div>
                    </div>
                </div>

                <h6 class="text-primary border-bottom pb-1 mt-4 mb-3">
                    <i class="bi bi-mortarboard"></i> Información académica
                </h6>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="text-muted small">Grado</div>
                        <div>@(e.NombreGrado ?? "—")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Estado académico</div>
                        <div>@e.EstadoAcademico</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Fecha de ingreso</div>
                        <div>@(e.FechaIngreso?.ToString("dd/MM/yyyy") ?? "—")</div>
                    </div>
                </div>

                <p class="text-muted small mt-4 mb-0">
                    <i class="bi bi-info-circle"></i>
                    Si algún dato es incorrecto, solicite la corrección a la administración.
                </p>
            </div>
        </div>
    }

</div>
