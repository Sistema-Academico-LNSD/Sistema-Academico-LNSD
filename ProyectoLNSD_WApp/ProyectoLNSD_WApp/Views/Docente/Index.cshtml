@{
    ViewData["Title"] = "Docentes";
    ViewData["Subtitle"] = "Expedientes del personal docente";
    ViewData["Icon"] = "bi-person-workspace";
    bool puedeCrear = User.TienePermiso("Docentes", "Crear");
    bool puedeEditar = User.TienePermiso("Docentes", "Editar");    
    bool puedeVerCursos = User.TienePermiso("AsignacionCursos", "Ver");
    bool puedeAsignarCursos = User.TienePermiso("AsignacionCursos", "Crear");
    bool puedeQuitarCursos = User.TienePermiso("AsignacionCursos", "Eliminar");
}

@section Acciones {
    @if (puedeCrear)
    {
        <button type="button" id="btnNuevoDocente" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo docente
        </button>
    }
}

<div class="card">
    <div class="card-body">

            <div class="row g-2 mb-3">

                <div class="col-md-4">
                    <input type="text" id="txtBuscar" class="form-control"
                           placeholder="Nombre, identificación, correo o especialidad..." />
                </div>

                <div class="col-md-2">
                    <select id="ddlFiltroArea" class="form-select">
                        <option value="">Todas las áreas</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <select id="ddlFiltroCurso" class="form-select" title="Curso asignado en el período activo">
                        <option value="">Todos los cursos</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <select id="ddlFiltroEstado" class="form-select">
                        <option value="">Todos</option>
                        <option value="true">Activos</option>
                        <option value="false">Inactivos</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="button" id="btnBuscar" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                    <button type="button" id="btnLimpiar" class="btn btn-outline-secondary" title="Limpiar filtros">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

            </div>

            <div class="table-responsive">

                <table id="tblDocentes" class="table table-striped table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Identificación</th>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Especialidad</th>
                            <th>Área</th>
                            <th>Cuenta</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                    </tbody>

                </table>

            </div>

            <small id="lblTotal" class="text-muted"></small>

        </div>

    </div>



@* Permisos JS *@
<input type="hidden" id="hdnPuedeEditar" value="@(puedeEditar ? "true" : "false")" />
<input type="hidden" id="hdnPuedeVerCursos" value="@(puedeVerCursos ? "true" : "false")" />
<input type="hidden" id="hdnPuedeAsignarCursos" value="@(puedeAsignarCursos ? "true" : "false")" />
<input type="hidden" id="hdnPuedeQuitarCursos" value="@(puedeQuitarCursos ? "true" : "false")" />


@if (puedeCrear || puedeEditar)
{
    @await Html.PartialAsync("_ModalDocente")
}

@if (puedeEditar)
{
    @await Html.PartialAsync("_ModalCuentaDocente")
}

@if (puedeVerCursos)
{
    @await Html.PartialAsync("_ModalCursosDocente")
}


@section Scripts {
    <script src="~/js/docente.js" asp-append-version="true"></script>
    <script src="~/js/docente-cursos.js" asp-append-version="true"></script>
}