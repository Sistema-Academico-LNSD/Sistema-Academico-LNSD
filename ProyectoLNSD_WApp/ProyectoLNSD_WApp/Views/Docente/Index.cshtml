@{
    ViewData["Title"] = "Docentes";
    bool puedeCrear = User.TienePermiso("Docentes", "Crear");
    bool puedeEditar = User.TienePermiso("Docentes", "Editar");
}

<div class="container-fluid mt-4">

    <div class="card shadow border-0">

        <div class="card-header bg-primary text-white">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h3 class="mb-0">
                        <i class="bi bi-person-video3"></i>
                        Docentes
                    </h3>
                    <small>Expedientes del personal docente</small>
                </div>

                @if (puedeCrear)
                {
                    <button type="button" id="btnNuevoDocente" class="btn btn-light">
                        <i class="bi bi-plus-circle"></i>
                        Nuevo docente
                    </button>
                }

            </div>

        </div>

        <div class="card-body">

            <div class="row g-2 mb-3">

                <div class="col-md-5">
                    <input type="text" id="txtBuscar" class="form-control"
                           placeholder="Nombre, identificación, correo o especialidad..." />
                </div>

                <div class="col-md-3">
                    <select id="ddlFiltroArea" class="form-select">
                        <option value="">Todas las áreas</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <select id="ddlFiltroEstado" class="form-select">
                        <option value="">Todos</option>
                        <option value="true">Activos</option>
                        <option value="false">Inactivos</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="button" id="btnBuscar" class="btn btn-success flex-grow-1">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                    <button type="button" id="btnLimpiar" class="btn btn-outline-secondary" title="Limpiar filtros">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

            </div>

            <div class="table-responsive">

                <table id="tblDocentes" class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Identificación</th>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Especialidad</th>
                            <th>Área</th>
                            <th>Cuenta</th>
                            <th>Estado</th>
                            @if (puedeEditar)
                            {
                                <th>Acciones</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                    </tbody>

                </table>

            </div>

            <small id="lblTotal" class="text-muted"></small>

        </div>

    </div>

</div>

@* Permisos JS *@
<input type="hidden" id="hdnPuedeEditar" value="@(puedeEditar ? "true" : "false")" />

@if (puedeCrear || puedeEditar)
{
    @await Html.PartialAsync("_ModalDocente")
}

@if (puedeEditar)
{
    @await Html.PartialAsync("_ModalCuentaDocente")
}

@section Scripts {
    <script src="~/js/docente.js" asp-append-version="true"></script>
}