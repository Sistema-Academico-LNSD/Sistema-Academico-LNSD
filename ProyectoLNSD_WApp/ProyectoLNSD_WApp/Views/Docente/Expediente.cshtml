@model ProyectoLNSD_WApp.BLL.DTO.ExpedienteDocenteDTO
@{
    ViewData["Title"] = $"Expediente — {Model.Docente.Nombre} {Model.Docente.Apellidos}";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3 no-print">
        <h4 class="mb-0 text-primary">
            <i class="bi bi-folder2-open"></i> Expediente docente
        </h4>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
                <i class="bi bi-printer"></i> Imprimir
            </button>
            <a asp-controller="Docente" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-arrow-left"></i> Volver a Docentes
            </a>
        </div>
    </div>

    @await Html.PartialAsync("_ExpedienteDocente", Model)

</div>