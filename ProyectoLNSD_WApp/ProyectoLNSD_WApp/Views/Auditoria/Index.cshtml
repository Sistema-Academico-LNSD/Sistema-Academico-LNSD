@{
    ViewData["Title"] = "Historial de Accesos";
}

<div class="container-fluid mt-4">

    <div class="card shadow border-0">

        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                <i class="bi bi-journal-text"></i>
                Historial de Accesos
            </h3>
            <small>Auditoría de inicios y cierres de sesión</small>
        </div>

        <div class="card-body">

            <div class="row mb-3 g-2">

                <div class="col-md-3">
                    <input type="text"
                           id="txtCorreo"
                           class="form-control"
                           placeholder="Buscar por correo..." />
                </div>

                <div class="col-md-2">
                    <input type="date" id="txtDesde" class="form-control" />
                </div>

                <div class="col-md-2">
                    <input type="date" id="txtHasta" class="form-control" />
                </div>

                <div class="col-md-2 d-flex align-items-center">
                    <div class="form-check">
                        <input type="checkbox" id="chkSoloFallidos" class="form-check-input" />
                        <label class="form-check-label" for="chkSoloFallidos">
                            Solo fallidos
                        </label>
                    </div>
                </div>

                <div class="col-md-3">
                    <button type="button" id="btnBuscarHistorial" class="btn btn-success">
                        <i class="bi bi-search"></i>
                        Buscar
                    </button>
                </div>

            </div>

            <div class="table-responsive">

                <table id="tblHistorial" class="table table-striped table-hover">

                    <thead class="table-dark">
                        <tr>
                            <th>Fecha</th>
                            <th>Evento</th>
                            <th>Usuario</th>
                            <th>Correo</th>
                            <th>Resultado</th>
                            <th>Detalle</th>
                        </tr>
                    </thead>

                    <tbody>
                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/auditoria.js"></script>
}