@{
    ViewData["Title"] = "Historial de accesos";
    ViewData["Subtitle"] = "Auditoría de inicios y cierres de sesión";
    ViewData["Icon"] = "bi-journal-text";
}

<div class="card">
    <div class="card-body">

            <div class="row mb-3 g-2">

                <div class="col-md-3">
                    <input type="text"
                           id="txtCorreo"
                           class="form-control"
                           placeholder="Buscar por correo..." />
                </div>

                <div class="col-md-2">
                    <input type="date" id="txtDesde" class="form-control" />
                </div>

                <div class="col-md-2">
                    <input type="date" id="txtHasta" class="form-control" />
                </div>

                <div class="col-md-2 d-flex align-items-center">
                    <div class="form-check">
                        <input type="checkbox" id="chkSoloFallidos" class="form-check-input" />
                        <label class="form-check-label" for="chkSoloFallidos">
                            Solo fallidos
                        </label>
                    </div>
                </div>

                <div class="col-md-3">
                    <button type="button" id="btnBuscarHistorial" class="btn btn-primary">
                        <i class="bi bi-search"></i>
                        Buscar
                    </button>
                </div>

            </div>

            <div class="table-responsive">

                <table id="tblHistorial" class="table table-striped table-hover">

                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Evento</th>
                            <th>Usuario</th>
                            <th>Correo</th>
                            <th>Resultado</th>
                            <th>Detalle</th>
                        </tr>
                    </thead>

                    <tbody>
                    </tbody>

                </table>

            </div>

        </div>

    </div>



@section Scripts {
    <script src="~/js/auditoria.js" asp-append-version="true"></script>
}