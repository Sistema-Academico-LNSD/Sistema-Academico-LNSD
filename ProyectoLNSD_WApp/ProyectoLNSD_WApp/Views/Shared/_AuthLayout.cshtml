@*
    Layout de AUTENTICACIÓN: Login, Recuperar y Restablecer contraseña.
*@
<!DOCTYPE html>
<html lang="es">
<head>
    <partial name="_Head" />
</head>
<body class="auth">

    <a asp-controller="Home" asp-action="Index" class="back-home-link">
        <i class="bi bi-arrow-left" aria-hidden="true"></i> Volver al inicio
    </a>

    <main class="auth-wrapper" role="main">
        <div class="auth-card card">
            <div class="auth-card-header">
                <img src="~/img/logo-lnsd.jpeg" alt="" width="56" height="56" />
                <div>
                    <div class="auth-brand">Sistema Académico LNSD</div>
                    <div class="auth-subtitle">@ViewData["Title"]</div>
                </div>
            </div>
            <div class="card-body p-4">
                @RenderBody()
            </div>
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
