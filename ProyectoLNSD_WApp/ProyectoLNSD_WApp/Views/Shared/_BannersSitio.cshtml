@model ProyectoLNSD_WApp.BLL.DTO.LandingDTO
@{
    // En la vista previa (HU 07) se muestran también los borradores, marcados con una etiqueta.
    bool esPrevia = ViewData["EsVistaPrevia"] as bool? == true;
}

@if (Model.Banners.Count > 0)
{
    <section class="mt-4">
        <div id="carruselBanners" class="carousel slide" data-bs-ride="carousel">

            @if (Model.Banners.Count > 1)
            {
                <div class="carousel-indicators">
                    @for (int i = 0; i < Model.Banners.Count; i++)
                    {
                        <button type="button" data-bs-target="#carruselBanners" data-bs-slide-to="@i"
                                class="@(i == 0 ? "active" : "")" aria-label="Banner @(i + 1)"></button>
                    }
                </div>
            }

            <div class="carousel-inner rounded shadow-sm">
                @for (int i = 0; i < Model.Banners.Count; i++)
                {
                    var banner = Model.Banners[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        @if (esPrevia && banner.Estado != "Publicado")
                        {
                            <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2" style="z-index:2;">Borrador</span>
                        }
                        <img src="@banner.RutaImagen" class="d-block w-100" alt="@banner.Titulo"
                             style="max-height:420px; object-fit:cover;" />
                        <div class="carousel-caption d-none d-md-block"
                             style="background: rgba(0,0,0,.45); border-radius:.5rem;">
                            <h3 class="h5">@banner.Titulo</h3>
                            @if (!string.IsNullOrWhiteSpace(banner.Descripcion))
                            {
                                <p class="mb-0">@banner.Descripcion</p>
                            }
                        </div>
                    </div>
                }
            </div>

            @if (Model.Banners.Count > 1)
            {
                <button class="carousel-control-prev" type="button" data-bs-target="#carruselBanners" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Anterior</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carruselBanners" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Siguiente</span>
                </button>
            }
        </div>
    </section>
}
