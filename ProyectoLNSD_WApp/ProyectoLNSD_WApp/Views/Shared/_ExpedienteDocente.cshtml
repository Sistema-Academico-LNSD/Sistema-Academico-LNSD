@model ProyectoLNSD_WApp.BLL.DTO.ExpedienteDocenteDTO
@*

*@
@{
    var d = Model.Docente;

    var titulos = (d.Titulos ?? string.Empty)
        .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    var historialPorPeriodo = Model.Cursos.Historial
        .GroupBy(a => new { a.IdPeriodo, a.NombrePeriodo })
        .ToList();
}

<div class="card shadow border-0 mb-4">
    <div class="card-body d-flex flex-wrap align-items-center gap-3">

        <div class="expediente-avatar">
            @(string.IsNullOrEmpty(d.Nombre) ? "?" : d.Nombre.Substring(0, 1).ToUpper())
        </div>

        <div class="flex-grow-1">
            <h3 class="mb-1">@d.Nombre @d.Apellidos</h3>
            <div class="text-muted">
                <i class="bi bi-person-vcard"></i> @d.Identificacion
                @if (!string.IsNullOrEmpty(d.Especialidad))
                {
                    <span class="ms-3"><i class="bi bi-mortarboard"></i> @d.Especialidad</span>
                }
            </div>
        </div>

        <div class="d-flex flex-column align-items-end gap-1">
            @if (d.Estado)
            {
                <span class="badge bg-success">Activo</span>
            }
            else
            {
                <span class="badge bg-danger">Inactivo</span>
            }

            @if (d.TieneCuenta)
            {
                <span class="badge bg-info text-dark"><i class="bi bi-person-check"></i> Con cuenta</span>
            }
            else
            {
                <span class="badge bg-light text-muted border">Sin cuenta</span>
            }
        </div>

    </div>
</div>

<div class="row g-4">

    <div class="col-lg-6">
        <div class="card shadow border-0 h-100">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-person-lines-fill"></i> Datos personales y de contacto
            </div>
            <div class="card-body">
                <dl class="row mb-0 expediente-datos">
                    <dt class="col-sm-5">Nombre completo</dt>
                    <dd class="col-sm-7">@d.Nombre @d.Apellidos</dd>

                    <dt class="col-sm-5">Identificación</dt>
                    <dd class="col-sm-7">@d.Identificacion</dd>

                    <dt class="col-sm-5">Correo</dt>
                    <dd class="col-sm-7">@d.Correo</dd>

                    <dt class="col-sm-5">Teléfono</dt>
                    <dd class="col-sm-7">@(d.Telefono ?? "—")</dd>

                    <dt class="col-sm-5">Dirección</dt>
                    <dd class="col-sm-7">@(d.Direccion ?? "—")</dd>

                    <dt class="col-sm-5">Cuenta del sistema</dt>
                    <dd class="col-sm-7">@(Model.CorreoCuenta ?? "Sin cuenta vinculada")</dd>

                    <dt class="col-sm-5">Registrado el</dt>
                    <dd class="col-sm-7">
                        <span data-fecha-utc="@d.FechaRegistro.ToString("o")"></span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow border-0 h-100">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-mortarboard"></i> Información profesional
            </div>
            <div class="card-body">
                <dl class="row mb-0 expediente-datos">
                    <dt class="col-sm-5">Especialidad</dt>
                    <dd class="col-sm-7">@(d.Especialidad ?? "—")</dd>

                    <dt class="col-sm-5">Área de enseñanza</dt>
                    <dd class="col-sm-7">@(d.NombreArea ?? "—")</dd>

                    <dt class="col-sm-5">Años de experiencia</dt>
                    <dd class="col-sm-7">@(d.AniosExperiencia?.ToString() ?? "—")</dd>

                    <dt class="col-sm-5">Títulos académicos</dt>
                    <dd class="col-sm-7">
                        @if (titulos.Length == 0)
                        {
                            <span>—</span>
                        }
                        else
                        {
                            <ul class="ps-3 mb-0">
                                @foreach (var titulo in titulos)
                                {
                                    <li>@titulo</li>
                                }
                            </ul>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow border-0 h-100">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-calendar-check"></i>
                Cursos asignados — @(Model.Cursos.NombrePeriodoActivo ?? "sin período activo")
            </div>
            <div class="card-body">
                @if (Model.Cursos.Actuales.Count == 0)
                {
                    <p class="text-muted mb-0">Sin cursos asignados en el período actual.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Código</th>
                                    <th>Curso</th>
                                    <th>Área</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in Model.Cursos.Actuales)
                                {
                                    <tr>
                                        <td>@a.CodigoCurso</td>
                                        <td>@a.NombreCurso</td>
                                        <td>@(a.NombreArea ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow border-0 h-100">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-clock-history"></i> Historial de cursos impartidos
            </div>
            <div class="card-body">
                @if (historialPorPeriodo.Count == 0)
                {
                    <p class="text-muted mb-0">Sin cursos en períodos anteriores.</p>
                }
                else
                {
                    @foreach (var periodo in historialPorPeriodo)
                    {
                        <div class="mb-3">
                            <div class="fw-semibold small text-secondary mb-1">
                                <i class="bi bi-calendar3"></i> @periodo.Key.NombrePeriodo
                            </div>
                            <ul class="list-group list-group-flush">
                                @foreach (var a in periodo)
                                {
                                    <li class="list-group-item px-0 py-1 small">
                                        <span class="text-muted">@a.CodigoCurso</span> — @a.NombreCurso
                                        @if (!string.IsNullOrEmpty(a.NombreArea))
                                        {
                                            <span class="text-muted">(@a.NombreArea)</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

</div>