@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="d-flex justify-content-center mt-4">

    <div class="card shadow border-0 text-center" style="width: 100%; max-width: 560px;">

        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0">
                <i class="bi bi-exclamation-octagon"></i>
                Ocurrió un error inesperado
            </h4>
        </div>

        <div class="card-body p-4">

            <p class="mb-2">
                No pudimos completar tu solicitud. El problema no fue causado por vos.
            </p>

            <p class="text-muted small">
                Intentá nuevamente en unos minutos. Si el error persiste,
                comunicate con la administración del liceo.
            </p>

            @if (Model.ShowRequestId)
            {
                <p class="text-muted small mb-4">
                    Código de referencia: <code>@Model.RequestId</code>
                </p>
            }

            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-house-door"></i> Volver al inicio
            </a>

        </div>

    </div>

</div>