@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    ViewData["OcultarEncabezado"] = true;
}

<div class="card card-narrow text-center mt-4">
    <div class="card-body p-4">
        <div class="hero-badge"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i></div>
        <h1 class="h3">Ocurrió un error inesperado</h1>
        <p class="mb-2">No pudimos completar tu solicitud. El problema no fue causado por vos.</p>
        <p class="text-muted small">
            Intentá nuevamente en unos minutos. Si el error persiste,
            comunicate con la administración del liceo.
        </p>
        @if (Model.ShowRequestId)
        {
            <p class="text-muted small mb-4">Código de referencia: <code>@Model.RequestId</code></p>
        }
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-house-door" aria-hidden="true"></i> Volver al inicio
        </a>
    </div>
</div>
