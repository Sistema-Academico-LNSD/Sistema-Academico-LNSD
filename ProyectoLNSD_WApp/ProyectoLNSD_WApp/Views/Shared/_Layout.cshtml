@{
    string controladorActual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    string EsActivo(string controlador) =>
        string.Equals(controladorActual, controlador, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";


    string accionActual = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string EsActivoAccion(string controlador, string accion) =>
        string.Equals(controladorActual, controlador, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(accionActual, accion, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";


    string? nombreUsuario = User.Identity?.Name;

    string inicialUsuario = !string.IsNullOrWhiteSpace(nombreUsuario)
        ? nombreUsuario.Trim()[0].ToString().ToUpper()
        : "?";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Académico LNSD</title>
    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProyectoLNSD_WApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-lnsd mb-3">
            <div class="container-fluid">

                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-badge">
                        <img src="~/img/logo-lnsd.jpeg" alt="LNSD" />
                    </span>
                    <span class="brand-text">
                        Sistema Académico LNSD
                        <small>Liceo Nuevo de Santo Domingo</small>
                    </span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link @EsActivo("Home")" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Inicio
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @* Cada enlace usa el mismo permiso que exige su controlador:
                               así nadie ve un enlace que lo lleve a "Acceso denegado". *@

                            @if (User.TienePermiso("Usuarios", "Ver"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @EsActivo("Usuario")" asp-controller="Usuario" asp-action="Index">
                                        <i class="bi bi-people"></i> Usuarios
                                    </a>
                                </li>
                            }

                            @if (User.TienePermiso("Docentes", "Ver"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @EsActivo("Docente")" asp-controller="Docente" asp-action="Index">
                                        <i class="bi bi-person-video3"></i> Docentes
                                    </a>
                                </li>
                            }

                            @if (User.TienePermiso("Estudiantes", "Ver"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @EsActivo("Estudiante")" asp-controller="Estudiante" asp-action="Index">
                                        <i class="bi bi-backpack2"></i> Estudiantes
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Estudiante"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @EsActivo("MiPerfil")" asp-controller="MiPerfil" asp-action="MiExpediente">
                                        <i class="bi bi-person-vcard"></i> Mi información
                                    </a>
                                </li>
                            }
 
                            @if (User.IsInRole("Encargado"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @EsActivo("MiPerfil")" asp-controller="MiPerfil" asp-action="MisEstudiantes">
                                        <i class="bi bi-people"></i> Mis estudiantes
                                    </a>
                                </li>
                            }

                            @if (User.TienePermiso("Grados", "Ver"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @EsActivo("Grado")" asp-controller="Grado" asp-action="Index">
                                        <i class="bi bi-diagram-3"></i> Grados y secciones
                                    </a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link @EsActivoAccion("Boleteria", "Index")" asp-controller="Boleteria" asp-action="Index">
                                    <i class="bi bi-ticket-perforated"></i> Mi tiquete
                                </a>
                            </li>

                            @if (User.TienePermiso("Boleteria", "Editar"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @EsActivoAccion("Boleteria", "Validar")" asp-controller="Boleteria" asp-action="Validar">
                                        <i class="bi bi-qr-code-scan"></i> Validar tiquetes
                                    </a>
                                </li>
                            }

                            @if (User.TienePermiso("Boleteria", "Ver"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @EsActivoAccion("Boleteria", "Consulta")" asp-controller="Boleteria" asp-action="Consulta">
                                        <i class="bi bi-clipboard-data"></i> Control de tiquetes
                                    </a>
                                </li>
                            }
                        }

                        @if (User.TienePermiso("Configuracion", "Ver"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @EsActivo("Configuracion")" asp-controller="Configuracion" asp-action="Index">
                                    <i class="bi bi-gear"></i> Configuración
                                </a>
                            </li>
                        }

                        @if (User.TienePermiso("Roles", "Ver"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @EsActivo("Rol")" asp-controller="Rol" asp-action="Index">
                                    <i class="bi bi-person-badge"></i> Roles
                                </a>
                            </li>
                        }

                        @* Permisos y Auditoría se protegen por rol en su controlador
                           ([Authorize(Roles = "Administrador")]), así que el menú usa la misma regla. *@
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @EsActivo("Permiso")" asp-controller="Permiso" asp-action="Index">
                                    <i class="bi bi-shield-lock"></i> Permisos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @EsActivo("Auditoria")" asp-controller="Auditoria" asp-action="Index">
                                    <i class="bi bi-journal-text"></i> Auditoría
                                </a>
                            </li>
                        }

                    </ul>

                    <div class="d-flex align-items-center">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form id="formLogoutNav" class="mb-0">
                                @Html.AntiForgeryToken()
                            </form>

                            <div class="dropdown">
                                <button class="btn user-menu-btn dropdown-toggle" type="button"
                                        data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="user-avatar">@inicialUsuario</span>
                                    <span class="d-none d-md-inline">@nombreUsuario</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <span class="dropdown-item-text text-muted small">
                                            @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                                        </span>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <button type="button" id="btnLogout" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-login-nav btn-sm" asp-controller="Auth" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
                            </a>
                        }

                    </div>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-lnsd">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>
                &copy; 2026 Sistema Académico LNSD &middot;
                <a asp-controller="Home" asp-action="Privacy" class="footer-link">Aviso de privacidad</a>
            </span>
            <span class="footer-motto">Estudio &bull; Esfuerzo &bull; Superación</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>