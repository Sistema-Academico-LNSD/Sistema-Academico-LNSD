@*
    MAIN Layout de la App (usuarios autenticados, todos los roles):
*@
@using System.Security.Claims
@{
    string nombreUsuario = User.Identity?.Name ?? "";
    string inicialUsuario = string.IsNullOrWhiteSpace(nombreUsuario) ? "?" : nombreUsuario.Trim()[0].ToString().ToUpper();
    string? rolUsuario = User.FindFirst(ClaimTypes.Role)?.Value;

    bool ocultarEncabezado = ViewData["OcultarEncabezado"] as bool? == true
                             || string.IsNullOrWhiteSpace(ViewData["Title"] as string);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <partial name="_Head" />
</head>
<body class="app">

    <a class="skip-link visually-hidden-focusable" href="#contenido">Saltar al contenido</a>

    <div class="app-sidebar-wrap">
        <partial name="_Sidebar" />
    </div>

    <div class="app-main">

        <header class="app-topbar">

            <button type="button" class="btn btn-icon d-lg-none"
                    data-bs-toggle="offcanvas" data-bs-target="#appSidebar"
                    aria-controls="appSidebar" aria-label="Abrir menú">
                <i class="bi bi-list" aria-hidden="true"></i>
            </button>

            <a class="app-topbar-brand d-lg-none" asp-controller="Home" asp-action="Index">LNSD</a>

            <div class="dropdown ms-auto">
                <button class="btn user-menu-btn dropdown-toggle" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="user-avatar" aria-hidden="true">@inicialUsuario</span>
                    <span class="user-info d-none d-sm-flex">
                        <span class="user-name">@nombreUsuario</span>
                        <span class="user-role">@rolUsuario</span>
                    </span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                    <li class="d-sm-none">
                        <span class="dropdown-item-text">
                            <strong>@nombreUsuario</strong><br />
                            <small class="text-muted">@rolUsuario</small>
                        </span>
                    </li>
                    <li class="d-sm-none"><hr class="dropdown-divider" /></li>
                    <li>
                        <a class="dropdown-item" asp-controller="Home" asp-action="Privacy">
                            <i class="bi bi-shield-check" aria-hidden="true"></i> Aviso de privacidad
                        </a>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        @* Formulario POST normal: funciona sin JavaScript y el tag helper agrega el token antiforgery. *@
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="dropdown-item text-danger">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Cerrar sesión
                            </button>
                        </form>
                    </li>
                </ul>
            </div>

        </header>

        <main id="contenido" class="app-content" role="main">

            @if (!ocultarEncabezado)
            {
                var acciones = IsSectionDefined("Acciones") ? await RenderSectionAsync("Acciones") : null;
                <partial name="_EncabezadoPagina" model="acciones" />
            }
            else if (IsSectionDefined("Acciones"))
            {
                IgnoreSection("Acciones");
            }

            @RenderBody()

        </main>

        <footer class="app-footer no-print">
            <span>&copy; @DateTime.Now.Year Liceo Nuevo de Santo Domingo</span>
            <span class="app-footer-motto">Estudio &bull; Esfuerzo &bull; Superación</span>
        </footer>

    </div>

    <partial name="_Scripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
